#!/usr/bin/env bash
# Generate the full CPC Isabelle session and install it into a local iogos tree.
# Usage: install_iogos
# Like install_logos, first publish through the driver, then copy the generated
# package and parser into $IOGOS_DIR/Cpc. Handwritten runtime and theories
# outside those generated files are preserved.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/common.sh"

BUILD_DIR="$(eoc_build_dir)"
FINAL_OUT_DIR="$(eoc_final_out_dir)"
IOGOS_DIR="${IOGOS_DIR:-$HOME/iogos}"

EOC_ISABELLE_CALC=Cpc "$SCRIPT_DIR/run_gen_isabelle_all"

eoc_step "Installing the generated Isabelle session into $(eoc_rel "$IOGOS_DIR/Cpc")"
python3 - "$FINAL_OUT_DIR/isabelle" "$IOGOS_DIR" <<'PY'
from pathlib import Path
import sys

source, iogos = map(Path, sys.argv[1:])
# Read everything before touching the installed copy, so failed generation or
# missing output leaves the last installation intact.
root = (source / "ROOT").read_text()
theories = {p.name: p.read_text() for p in source.glob("*.thy")}
runtime = {name: (source / "Runtime" / name).read_text() for name in
           ("Parser.ML", "Sexp.ML", "syntax.json", "generate_syntax.py")}
if not {"Cpc_Checker.thy", "Cpc_Spec.thy"} <= theories.keys():
    raise SystemExit("error: generated CPC Isabelle theories are missing")
banner = ("(* Auto-generated by ethos tools/eoc/cpc/install_iogos.\n"
          "   Change the Eunoia signature or compiler instead of this file. *)\n\n")
dest = iogos / "Cpc"
dest.mkdir(parents=True, exist_ok=True)
for name, text in theories.items():
    (dest / name).write_text(banner + text)
(dest / "ROOT").write_text(root)
(dest / "Runtime").mkdir(exist_ok=True)
for name, text in runtime.items():
    (dest / "Runtime" / name).write_text(
        (banner if name.endswith(".ML") else "") + text)
# Register the session without replacing any existing session directories.
roots = iogos / "ROOTS"
text = roots.read_text() if roots.exists() else ""
if "Cpc" not in (line.strip() for line in text.splitlines()):
    roots.write_text(text + ("\n" if text and not text.endswith("\n") else "")
                     + "Cpc\n")
PY

printf -v build_command 'isabelle build -D %q' "$IOGOS_DIR"
eoc_step "Installed CPC; build with: $build_command"
