#!/usr/bin/env bash
# Generate Isabelle/HOL output for every declaration in the CPC signature.
# Usage: run_gen_isabelle_all [INPUT]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/common.sh"

BUILD_DIR="$(eoc_build_dir)"
INPUT="${1:-$(eoc_cpc_input)}"
ARGS=(isabelle --build-dir "$BUILD_DIR" --all)

eoc_add_no_build
# This supplies CPC's exclusions and desugar definitions. The initial
# Isabelle checker does not use the SMT model or Lean termination clauses.
eoc_add_semantics
if [[ -n "${EOC_ISABELLE_CALC:-}" ]]; then
  ARGS+=("--calc-name=$EOC_ISABELLE_CALC")
fi
ARGS+=("$INPUT")
eoc_exec_driver "${ARGS[@]}"
