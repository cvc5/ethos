//! Generated, parser-free proof checker. See functions.tsv for EO counterparts.
//!
//! The compiled checker establishes derivability in the supplied calculus.
//! A Logos soundness result additionally requires the translation side
//! conditions and refinement of this runtime. Neither is assumed here.
#![forbid(unsafe_code)]
#![allow(non_camel_case_types)]
#![allow(non_snake_case)]
// The checking functions are written in the plain subset of Rust that the
// verification tools translate: explicit matches and loops, not macros,
// closures or iterator adaptors.
#![allow(clippy::match_like_matches_macro, clippy::manual_map)]

mod bitvec;
mod cache;
pub mod codec;
mod eostring;
mod front;
#[allow(unreachable_code, unused_labels, unused_variables)]
// Uniform temporaries make evaluation order and refinement obligations explicit.
#[allow(
    clippy::let_and_return,
    clippy::almost_swapped,
    clippy::too_many_arguments,
    clippy::only_used_in_recursion
)]
pub mod generated;
pub mod kind;
mod lit;
#[allow(dead_code)] // A signature need not use every native operation.
mod native;
mod num;
#[allow(clippy::match_like_matches_macro)]
mod schema;

pub use bitvec::BitVec;
pub use cache::CacheStats;
use cache::{Caches, ProgramId, TypeCacheKind};
pub use eostring::{EoString, NUM_CODES};
pub use kind::{EvalOp, LitKind};
pub use lit::Lit;
pub use native::NativeOp;
pub use num::{Integer, Rational};
pub use schema::Constructor;
use std::collections::HashMap;

/// A cheap multiply-rotate hash for the interning table. Its keys are the
/// checker's own terms and lookups compare the full key, so the hash only
/// affects speed; SipHash's protection against chosen collisions is not
/// needed here.
#[derive(Default, Clone, Copy)]
struct TermHasher(u64);
impl std::hash::Hasher for TermHasher {
    fn finish(&self) -> u64 {
        self.0
    }
    fn write(&mut self, bytes: &[u8]) {
        let (chunks, rest) = bytes.as_chunks::<8>();
        for c in chunks {
            self.add(u64::from_le_bytes(*c));
        }
        for &b in rest {
            self.add(u64::from(b));
        }
    }
    fn write_u8(&mut self, i: u8) {
        self.add(u64::from(i))
    }
    fn write_u32(&mut self, i: u32) {
        self.add(u64::from(i))
    }
    fn write_u64(&mut self, i: u64) {
        self.add(i)
    }
    fn write_usize(&mut self, i: usize) {
        self.add(i as u64)
    }
}
impl TermHasher {
    #[inline]
    fn add(&mut self, w: u64) {
        self.0 = (self.0.rotate_left(5) ^ w).wrapping_mul(0x517c_c1b7_2722_0a95);
    }
}
type TermBuildHasher = std::hash::BuildHasherDefault<TermHasher>;
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum CheckError {
    InvalidHandle,
    InvalidConstructor,
    InvalidNative,
    /// An operation the runtime does not have, by its name.
    UnsupportedNative(&'static str),
    Limit,
    Worker,
}
impl std::error::Error for CheckError {}
pub type CheckResult<T> = Result<T, CheckError>;

/// How the store represents the terms a constructor builds. The generator
/// says which it is for each constructor (`Constructor::embedding`), from
/// the constructor's name in the embedding of terms; the runtime compares no
/// names.
#[derive(Copy, Clone, Debug, PartialEq, Eq)]
pub enum Embedding {
    /// `$emb_Stuck`: the stuck term.
    Stuck,
    /// `$emb_Apply`: an application.
    Apply,
    /// `$emb_Boolean`, `$emb_Numeral`, `$emb_Rational`, `$emb_String`,
    /// `$emb_Binary`: an object literal, built from native values.
    Boolean,
    Numeral,
    Rational,
    String,
    Binary,
    /// `$emb_UOp`, `$emb_UOp1`, ...: the view of a user operator with its
    /// indices as an operator applied to them.
    UOp,
    /// `$emb_Var`: a variable, which is data.
    Var,
    /// Any other constructor: data.
    Data,
}

/// An arena-local handle. Obtain handles through Store's constructors.
#[derive(Copy, Clone, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct Term(u32);

/// The structural embedding. Native fields have a separate representation
/// from object-language literals. Nodes carry the generated constructor tag;
/// their child count is checked against the generated schema on construction.
#[derive(Clone, Debug, PartialEq, Eq, Hash)]
pub enum TermData {
    Stuck,
    Literal(Lit),
    Native(Lit),
    UserOp(Constructor),
    Apply(Term, Term),
    Node(Constructor, Vec<Term>),
}

#[derive(Copy, Clone, Debug)]
pub struct Limits {
    pub terms: u32,
    pub calls: u64,
    pub depth: u32,
}

const CHECKER_STACK_SIZE: usize = 256 * 1024 * 1024;
// A conservative space budget for each generated call, including its case
// helper and runtime calls. This is a default, not a static frame-size bound.
const DEFAULT_DEPTH: u32 = (CHECKER_STACK_SIZE / (16 * 1024)) as u32;

impl Default for Limits {
    fn default() -> Self {
        Self {
            terms: 10_000_000,
            calls: 10_000_000,
            // Allow ordinary deep terms on the 256 MiB checker stack.
            // Covered by deep-term regressions in debug and release builds.
            depth: DEFAULT_DEPTH,
        }
    }
}

/// What `destruct` found, before the native fields are interned.
enum Hit {
    Done(Option<Vec<Term>>),
    Raw(Lit),
    Binary(Integer, Integer),
}

/// Monotonically growing, hash-consed arena. Hashes select buckets only;
/// equality is always checked, so collisions cannot identify different terms.
pub struct Store {
    nodes: Vec<TermData>,
    intern: HashMap<TermData, Term, TermBuildHasher>,
    caches: Caches,
    limits: Limits,
    calls: u64,
    depth: u32,
    /// Jump pointers over state lists, for `state_proven_nth`, indexed by
    /// term handle. The entry of a `cons` node, once computed, is its depth
    /// and one node further down the same list; the depth is the number of
    /// `cons` nodes from the node to the end of its list, so it is never 0,
    /// and depth 0 means "not computed". The vector is only as long as the
    /// largest handle with an entry. Correctness rests on one invariant: an
    /// entry `(d, j)` of node `t` has `d` equal to the depth of `t`, and `j`
    /// is what following tails from `t` reaches after between one and `d`
    /// steps (the list's end being at depth zero). Which such `j` is chosen
    /// only affects speed.
    state_jumps: Vec<(u32, Term)>,
}
impl Default for Store {
    fn default() -> Self {
        Self::new(Limits::default())
    }
}
impl Store {
    pub fn new(limits: Limits) -> Self {
        let stuck = TermData::Stuck;
        let mut intern: HashMap<TermData, Term, TermBuildHasher> = HashMap::default();
        intern.insert(stuck.clone(), Term(0));
        Self {
            nodes: vec![stuck],
            intern,
            caches: Caches::new(limits.terms as usize),
            limits,
            calls: 0,
            depth: 0,
            state_jumps: Vec::new(),
        }
    }
    pub fn stuck(&self) -> Term {
        Term(0)
    }
    pub fn view(&self, t: Term) -> CheckResult<&TermData> {
        self.nodes
            .get(t.0 as usize)
            .ok_or(CheckError::InvalidHandle)
    }
    fn intern(&mut self, data: TermData) -> CheckResult<Term> {
        if let Some(&t) = self.intern.get(&data) {
            return Ok(t);
        }
        let n = u32::try_from(self.nodes.len()).map_err(|_| CheckError::Limit)?;
        if n >= self.limits.terms {
            return Err(CheckError::Limit);
        }
        let t = Term(n);
        self.intern.insert(data.clone(), t);
        self.nodes.push(data);
        self.caches.push_term();
        Ok(t)
    }
    /// Caches contain only completed pure results and remain valid as the
    /// arena grows and across proof checks. Disable them to measure a baseline.
    pub fn set_caching(&mut self, enabled: bool) {
        self.caches.set_enabled(enabled);
    }
    pub fn clear_caches(&mut self) {
        self.caches.clear();
    }
    pub fn cache_stats(&self) -> CacheStats {
        self.caches.stats()
    }
    pub(crate) fn cached_type(
        &mut self,
        kind: TypeCacheKind,
        term: Term,
    ) -> CheckResult<Option<Term>> {
        self.view(term)?;
        Ok(self.caches.type_get(kind, term))
    }
    pub(crate) fn cache_type(
        &mut self,
        kind: TypeCacheKind,
        term: Term,
        result: Term,
    ) -> CheckResult<()> {
        self.view(term)?;
        self.view(result)?;
        self.caches.type_insert(kind, term, result);
        Ok(())
    }
    pub(crate) fn cached_program(
        &mut self,
        program: ProgramId,
        args: &[Term],
    ) -> CheckResult<Option<Term>> {
        let mut i = 0;
        while i < args.len() {
            self.view(args[i])?;
            i += 1;
        }
        Ok(self.caches.program_get(program, args))
    }
    pub(crate) fn cache_program(
        &mut self,
        program: ProgramId,
        args: &[Term],
        result: Term,
    ) -> CheckResult<()> {
        let mut i = 0;
        while i < args.len() {
            self.view(args[i])?;
            i += 1;
        }
        self.view(result)?;
        self.caches.program_insert(program, args, result);
        Ok(())
    }
    pub fn literal(&mut self, lit: Lit) -> CheckResult<Term> {
        // Logos has one rational and one binary constructor.
        let lit = match lit {
            Lit::Decimal(q) => Lit::Rational(q),
            Lit::Hex(b) => Lit::Binary(b),
            l => l,
        };
        self.intern(TermData::Literal(lit))
    }
    pub fn raw(&mut self, lit: Lit) -> CheckResult<Term> {
        self.intern(TermData::Native(lit))
    }
    pub fn boolean(&mut self, b: bool) -> CheckResult<Term> {
        self.literal(Lit::Bool(b))
    }
    pub fn numeral(&mut self, n: Integer) -> CheckResult<Term> {
        self.literal(Lit::Numeral(n))
    }
    pub fn is_stuck(&self, t: Term) -> CheckResult<bool> {
        Ok(matches!(self.view(t)?, TermData::Stuck))
    }
    pub fn boolean_value(&self, t: Term, native: bool) -> CheckResult<Option<bool>> {
        Ok(match (native, self.view(t)?) {
            (false, TermData::Literal(Lit::Bool(b))) | (true, TermData::Native(Lit::Bool(b))) => {
                Some(*b)
            }
            _ => None,
        })
    }
    pub fn apply(&mut self, f: Term, a: Term) -> CheckResult<Term> {
        if self.is_stuck(f)? || self.is_stuck(a)? {
            return Ok(self.stuck());
        }
        self.intern(TermData::Apply(f, a))
    }
    pub fn unapply(&self, t: Term) -> CheckResult<Option<(Term, Term)>> {
        Ok(match self.view(t)? {
            TermData::Apply(f, a) => Some((*f, *a)),
            _ => None,
        })
    }
    /// Whether `t` is built by the constructor `c`, as data. `None` is a
    /// constructor the signature does not have.
    pub(crate) fn is_node(&self, t: Term, c: Option<Constructor>) -> CheckResult<bool> {
        Ok(match (self.view(t)?, c) {
            (TermData::Node(d, _), Some(c)) => *d == c,
            _ => false,
        })
    }
    /// The fields of `t` if it is built by the constructor `c`, as data.
    pub(crate) fn node_fields(
        &self,
        t: Term,
        c: Option<Constructor>,
    ) -> CheckResult<Option<Vec<Term>>> {
        Ok(match (self.view(t)?, c) {
            (TermData::Node(d, fs), Some(c)) if *d == c => Some(fs.clone()),
            _ => None,
        })
    }
    /// Whether `t` is a variable (`$emb_Var`).
    fn is_variable(&self, t: Term) -> CheckResult<bool> {
        Ok(match self.view(t)? {
            TermData::Node(c, _) => match c.embedding() {
                Embedding::Var => true,
                _ => false,
            },
            _ => false,
        })
    }
    pub fn construct(&mut self, c: Constructor, args: &[Term]) -> CheckResult<Term> {
        if c.arity() != args.len() {
            return Err(CheckError::InvalidConstructor);
        }
        for &t in args {
            self.view(t)?;
        }
        let e = c.embedding();
        match e {
            Embedding::UOp => self.construct_user(args),
            Embedding::Stuck if args.is_empty() => Ok(self.stuck()),
            Embedding::Apply if args.len() == 2 => self.apply(args[0], args[1]),
            Embedding::Boolean | Embedding::Numeral | Embedding::Rational | Embedding::String
                if args.len() == 1 =>
            {
                self.construct_literal(e, args[0])
            }
            Embedding::Binary if args.len() == 2 => self.construct_binary(args[0], args[1]),
            // All other constructors are data, including CState.Stuck.
            _ => self.intern(TermData::Node(c, args.to_vec())),
        }
    }
    /// A user operator from its wrapper view: the operator, then its fields.
    fn construct_user(&mut self, args: &[Term]) -> CheckResult<Term> {
        if args.is_empty() {
            return Err(CheckError::InvalidConstructor);
        }
        let user = match self.view(args[0])? {
            TermData::UserOp(user) => *user,
            _ => return Err(CheckError::InvalidConstructor),
        };
        self.construct(user, &args[1..])
    }
    /// An object literal from the native value `v` of its kind.
    fn construct_literal(&mut self, e: Embedding, v: Term) -> CheckResult<Term> {
        let lit = match self.view(v)? {
            TermData::Native(lit) => lit,
            _ => return Err(CheckError::InvalidNative),
        };
        let valid = match (e, lit) {
            (Embedding::Boolean, Lit::Bool(_)) => true,
            (Embedding::Numeral, Lit::Numeral(_)) => true,
            (Embedding::Rational, Lit::Rational(_)) => true,
            (Embedding::String, Lit::String(_)) => true,
            _ => false,
        };
        if !valid {
            return Err(CheckError::InvalidNative);
        }
        let lit = lit.clone();
        self.literal(lit)
    }
    /// A binary literal from its native width and value.
    fn construct_binary(&mut self, w: Term, v: Term) -> CheckResult<Term> {
        let w = self.raw_int(w)?;
        let v = self.raw_int(v)?;
        if !w.fits_u32() {
            return Err(CheckError::Limit);
        }
        self.literal(Lit::Binary(BitVec::new(w.to_u32(), &v)))
    }
    pub fn destruct(&mut self, c: Constructor, t: Term) -> CheckResult<Option<Vec<Term>>> {
        // Matching by reference: only what is returned is copied.
        let e = c.embedding();
        if let Embedding::UOp = e {
            return self.destruct_user(c, t);
        }
        let hit = match self.view(t)? {
            TermData::Stuck => match e {
                Embedding::Stuck => Hit::Done(Some(Vec::new())),
                _ => Hit::Done(None),
            },
            TermData::Apply(f, a) => match e {
                Embedding::Apply => Hit::Done(Some(vec![*f, *a])),
                _ => Hit::Done(None),
            },
            TermData::Literal(lit) => match (e, lit) {
                (Embedding::Boolean, Lit::Bool(_))
                | (Embedding::Numeral, Lit::Numeral(_))
                | (Embedding::Rational, Lit::Rational(_))
                | (Embedding::String, Lit::String(_)) => Hit::Raw(lit.clone()),
                (Embedding::Binary, Lit::Binary(b)) => {
                    Hit::Binary(Integer::from(b.size()), b.value().clone())
                }
                _ => Hit::Done(None),
            },
            TermData::Node(d, fields) if c == *d => Hit::Done(Some(fields.clone())),
            _ => Hit::Done(None),
        };
        match hit {
            Hit::Done(r) => Ok(r),
            Hit::Raw(lit) => {
                let v = self.raw(lit)?;
                Ok(Some(vec![v]))
            }
            Hit::Binary(size, value) => {
                let size = self.raw(Lit::Numeral(size))?;
                let value = self.raw(Lit::Numeral(value))?;
                Ok(Some(vec![size, value]))
            }
        }
    }
    /// The wrapper view of a user operator: the operator, then its fields.
    fn destruct_user(&mut self, c: Constructor, t: Term) -> CheckResult<Option<Vec<Term>>> {
        let (user, fields) = match self.view(t)? {
            TermData::Node(user, fields) if user.is_user() && fields.len() + 1 == c.arity() => {
                (*user, fields.clone())
            }
            _ => return Ok(None),
        };
        let op = self.intern(TermData::UserOp(user))?;
        let mut args = Vec::with_capacity(fields.len() + 1);
        args.push(op);
        args.extend_from_slice(&fields);
        Ok(Some(args))
    }
    /// `$eo_state_proven_nth` of the checking loop (eo_desugar_checker.eo),
    /// which the generator compiles to this call. The program walks the
    /// state list one element at a time, creating and interning a native
    /// numeral at each; on long proofs that walk dominates. This finds the
    /// same element in O(log n) steps with jump pointers, and charges the
    /// same budget as the walk (one `tick` per element visited, failing with
    /// `Limit` exactly when the walk would). Results, as the program's:
    /// - the index-th element (from 0) of a list with more elements gives
    ///   `proven(element)`;
    /// - a negative index, or one past the end, gives the object literal
    ///   `true` after walking the whole list;
    /// - a state that is not a `cons` gives `true`;
    /// - an index that is not a native numeral, on a `cons`, is
    ///   `InvalidNative`.
    pub(crate) fn state_proven_nth(
        &mut self,
        cons: Constructor,
        state: Term,
        index: Term,
        proven: fn(&mut Store, Term) -> CheckResult<Term>,
    ) -> CheckResult<Term> {
        let depth = self.state_depth(cons, state)?;
        if depth == 0 {
            self.charge(1)?;
            return self.literal(Lit::Bool(true));
        }
        // None: not a native numeral; Some(None): never reaches 0.
        let n: Option<Option<u64>> = match self.view(index)? {
            TermData::Native(Lit::Numeral(n)) => Some(if n.sgn() >= 0 && n.fits_u32() {
                Some(u64::from(n.to_u32()))
            } else {
                None
            }),
            _ => None,
        };
        match n {
            None => {
                self.charge(1)?;
                Err(CheckError::InvalidNative)
            }
            Some(Some(k)) if k < u64::from(depth) => {
                self.charge(k + 1)?;
                let node = self.state_ancestor(cons, state, depth - k as u32)?;
                let element = match self.view(node)? {
                    TermData::Node(_, fields) => fields[0],
                    _ => return Err(CheckError::InvalidNative),
                };
                proven(self, element)
            }
            Some(_) => {
                self.charge(u64::from(depth) + 1)?;
                self.literal(Lit::Bool(true))
            }
        }
    }
    /// `count` ticks at once, failing exactly when `count` calls of `tick`
    /// would.
    fn charge(&mut self, count: u64) -> CheckResult<()> {
        if self.calls.saturating_add(count) > self.limits.calls {
            self.calls = self.limits.calls;
            return Err(CheckError::Limit);
        }
        self.calls += count;
        Ok(())
    }
    /// The tail of a `cons` node, or None if `t` is not one.
    fn state_tail(&self, cons: Constructor, t: Term) -> CheckResult<Option<Term>> {
        Ok(match self.view(t)? {
            TermData::Node(c, fields) if *c == cons && fields.len() == 2 => Some(fields[1]),
            _ => None,
        })
    }
    /// The jump-pointer entry of `t`, if computed.
    fn state_jump(&self, t: Term) -> Option<(u32, Term)> {
        self.state_jumps
            .get(t.0 as usize)
            .copied()
            .filter(|&(d, _)| d > 0)
    }
    fn set_state_jump(&mut self, t: Term, entry: (u32, Term)) {
        let i = t.0 as usize;
        if self.state_jumps.len() <= i {
            self.state_jumps.resize(i + 1, (0, Term(0)));
        }
        self.state_jumps[i] = entry;
    }
    /// The number of `cons` nodes from `t` to the end of its list (0 if `t`
    /// is not a `cons`), computing jump pointers for the nodes on the way
    /// that have none yet, from the bottom up.
    fn state_depth(&mut self, cons: Constructor, t: Term) -> CheckResult<u32> {
        let mut pending = Vec::new();
        let mut x = t;
        let mut base = loop {
            if let Some((d, _)) = self.state_jump(x) {
                break d;
            }
            match self.state_tail(cons, x)? {
                Some(tail) => {
                    pending.push((x, tail));
                    x = tail;
                }
                None => break 0,
            }
        };
        // Myers's jump pointers: a node jumps two jumps of its tail when the
        // tail's two jumps span equal distances, and to its tail otherwise.
        // That keeps each node's jump at most a power-of-two-ish distance,
        // so finding an ancestor takes O(log depth) steps.
        while let Some((node, tail)) = pending.pop() {
            base += 1;
            let jump = match self.state_jump(tail) {
                Some((dt, jt)) => match self.state_jump(jt) {
                    Some((dj, jj)) => {
                        let djj = self.state_jump(jj).map_or(0, |e| e.0);
                        if dt - dj == dj - djj { jj } else { tail }
                    }
                    None => tail,
                },
                None => tail,
            };
            self.set_state_jump(node, (base, jump));
        }
        Ok(base)
    }
    /// The node at depth `target` (>= 1) below `t`, a `cons` node of depth at
    /// least `target` whose jump pointers are computed.
    fn state_ancestor(&self, cons: Constructor, t: Term, target: u32) -> CheckResult<Term> {
        let mut x = t;
        loop {
            let Some((d, jump)) = self.state_jump(x) else {
                return Err(CheckError::InvalidNative);
            };
            if d == target {
                return Ok(x);
            }
            let dj = self.state_jump(jump).map_or(0, |e| e.0);
            x = if dj >= target {
                jump
            } else {
                match self.state_tail(cons, x)? {
                    Some(tail) => tail,
                    None => return Err(CheckError::InvalidNative),
                }
            };
        }
    }
    fn raw_int(&self, t: Term) -> CheckResult<Integer> {
        match self.view(t)? {
            TermData::Native(Lit::Numeral(n)) => Ok(n.clone()),
            _ => Err(CheckError::InvalidNative),
        }
    }
    fn raw_rat(&self, t: Term) -> CheckResult<Rational> {
        match self.view(t)? {
            TermData::Native(Lit::Rational(n)) => Ok(n.clone()),
            _ => Err(CheckError::InvalidNative),
        }
    }
    fn object_index(&self, t: Term) -> CheckResult<Option<u32>> {
        Ok(match self.view(t)? {
            TermData::Literal(Lit::Numeral(n)) if n.fits_u32() => Some(n.to_u32()),
            _ => None,
        })
    }
    /// The place of a term's constructor in LogosTermOrder.
    fn order_key(d: &TermData) -> CheckResult<(usize, usize)> {
        let e = match d {
            TermData::Stuck => Embedding::Stuck,
            TermData::Apply(..) => Embedding::Apply,
            TermData::Literal(Lit::Bool(_)) => Embedding::Boolean,
            TermData::Literal(Lit::Numeral(_)) => Embedding::Numeral,
            TermData::Literal(Lit::Rational(_) | Lit::Decimal(_)) => Embedding::Rational,
            TermData::Literal(Lit::String(_)) => Embedding::String,
            TermData::Literal(Lit::Binary(_) | Lit::Hex(_)) => Embedding::Binary,
            TermData::Node(c, _) => return Ok(c.order_key()),
            TermData::Native(_) => return Ok((0, 0)),
            TermData::UserOp(c) => return Ok(c.order_key()),
        };
        match Constructor::of_embedding(e) {
            Some(c) => Ok(c.order_key()),
            None => Err(CheckError::InvalidConstructor),
        }
    }
    /// LogosTermOrder: constructor index, then fields from left to right.
    /// It does not depend on insertion order in the arena or hash values.
    pub fn compare(&self, a: Term, b: Term) -> CheckResult<std::cmp::Ordering> {
        use std::cmp::Ordering;
        let literal_cmp = |a: &Lit, b: &Lit| -> CheckResult<Ordering> {
            Ok(match (a, b) {
                (Lit::Bool(a), Lit::Bool(b)) => a.cmp(b),
                (Lit::Numeral(a), Lit::Numeral(b)) => a.cmp(b),
                (Lit::Rational(a), Lit::Rational(b)) => {
                    let (a, b) = (a.to_string(), b.to_string());
                    let (an, ad) = a.split_once('/').ok_or(CheckError::InvalidNative)?;
                    let (bn, bd) = b.split_once('/').ok_or(CheckError::InvalidNative)?;
                    parse_int(an)?
                        .cmp(&parse_int(bn)?)
                        .then(parse_int(ad)?.cmp(&parse_int(bd)?))
                }
                (Lit::String(a), Lit::String(b)) => a.code_points().cmp(b.code_points()),
                (Lit::Binary(a), Lit::Binary(b)) => {
                    a.size().cmp(&b.size()).then(a.value().cmp(b.value()))
                }
                _ => return Err(CheckError::InvalidNative),
            })
        };
        let mut todo = vec![(a, b)];
        while let Some((a, b)) = todo.pop() {
            if a == b {
                continue;
            }
            let (a, b) = (self.view(a)?, self.view(b)?);
            let tags = Self::order_key(a)?.cmp(&Self::order_key(b)?);
            if tags != Ordering::Equal {
                return Ok(tags);
            }
            match (a, b) {
                (TermData::Literal(a), TermData::Literal(b))
                | (TermData::Native(a), TermData::Native(b)) => {
                    let order = literal_cmp(a, b)?;
                    if order != Ordering::Equal {
                        return Ok(order);
                    }
                }
                (TermData::Apply(af, aa), TermData::Apply(bf, ba)) => {
                    todo.push((*aa, *ba));
                    todo.push((*af, *bf));
                }
                (TermData::UserOp(_), TermData::UserOp(_)) => {}
                (TermData::Node(_, a), TermData::Node(_, b)) if a.len() == b.len() => {
                    todo.extend(a.iter().zip(b).rev().map(|(&a, &b)| (a, b)))
                }
                _ => return Err(CheckError::InvalidConstructor),
            }
        }
        Ok(Ordering::Equal)
    }
    pub(crate) fn enter(&mut self) -> CheckResult<()> {
        if self.depth >= self.limits.depth || self.calls >= self.limits.calls {
            return Err(CheckError::Limit);
        }
        self.depth += 1;
        self.calls += 1;
        Ok(())
    }
    pub(crate) fn tick(&mut self) -> CheckResult<()> {
        if self.calls >= self.limits.calls {
            return Err(CheckError::Limit);
        }
        self.calls += 1;
        Ok(())
    }
    pub(crate) fn leave(&mut self) {
        self.depth -= 1;
    }

    /// Ethos-style primitive evaluation over already evaluated values.
    /// Stuck is explicit; recognizers and IsOk/IsEq return false on it.
    pub fn builtin(&mut self, op: EvalOp, args: &[Term]) -> CheckResult<Term> {
        let arity = match op {
            EvalOp::IsOk
            | EvalOp::Hash
            | EvalOp::TypeOf
            | EvalOp::NameOf
            | EvalOp::Not
            | EvalOp::Neg
            | EvalOp::IsNeg
            | EvalOp::Length
            | EvalOp::ToInt
            | EvalOp::ToRat
            | EvalOp::ToString
            | EvalOp::IsZ
            | EvalOp::IsQ
            | EvalOp::IsBin
            | EvalOp::IsStr
            | EvalOp::IsBool
            | EvalOp::IsVar
            | EvalOp::DtConstructors
            | EvalOp::DtSelectors => 1,
            EvalOp::IfThenElse
            | EvalOp::Requires
            | EvalOp::Cons
            | EvalOp::ListConcat
            | EvalOp::ListNth
            | EvalOp::ListFind
            | EvalOp::ListErase
            | EvalOp::ListEraseAll
            | EvalOp::ListMinclude
            | EvalOp::ListMeq
            | EvalOp::ListDiff
            | EvalOp::ListInter
            | EvalOp::ListRepeat
            | EvalOp::Extract => 3,
            _ => 2,
        };
        if (op.is_nary() && args.len() < 2) || (!op.is_nary() && args.len() != arity) {
            return Ok(self.stuck());
        }
        for &t in args {
            self.view(t)?;
        }
        let x = args[0];
        if op == EvalOp::IsOk {
            return self.boolean(!self.is_stuck(x)?);
        }
        if op == EvalOp::IsEq {
            return self.boolean(!self.is_stuck(x)? && !self.is_stuck(args[1])? && x == args[1]);
        }
        if op == EvalOp::Eq {
            return if args.iter().any(|&a| self.is_stuck(a).unwrap_or(true)) {
                Ok(self.stuck())
            } else {
                self.boolean(x == args[1])
            };
        }
        if op == EvalOp::IfThenElse {
            return Ok(match self.boolean_value(x, false)? {
                Some(true) => args[1],
                Some(false) => args[2],
                _ => self.stuck(),
            });
        }
        if op == EvalOp::Requires {
            return Ok(if x == args[1] && !self.is_stuck(x)? {
                args[2]
            } else {
                self.stuck()
            });
        }
        // Logos's recognizers are total predicates, including on Stuck.
        if matches!(
            op,
            EvalOp::IsZ
                | EvalOp::IsQ
                | EvalOp::IsBin
                | EvalOp::IsStr
                | EvalOp::IsBool
                | EvalOp::IsVar
        ) {
            let b = matches!(
                (op, self.view(x)?),
                (EvalOp::IsZ, TermData::Literal(Lit::Numeral(_)))
                    | (EvalOp::IsQ, TermData::Literal(Lit::Rational(_)))
                    | (EvalOp::IsBin, TermData::Literal(Lit::Binary(_)))
                    | (EvalOp::IsStr, TermData::Literal(Lit::String(_)))
                    | (EvalOp::IsBool, TermData::Literal(Lit::Bool(_)))
            ) || (op == EvalOp::IsVar && self.is_variable(x)?);
            return self.boolean(b);
        }
        if args.iter().any(|&a| self.is_stuck(a).unwrap_or(true)) {
            return Ok(self.stuck());
        }
        if op == EvalOp::NameOf {
            if !self.is_variable(x)? {
                return Ok(self.stuck());
            }
            return Ok(match self.view(x)? {
                TermData::Node(_, fields) => fields[0],
                _ => self.stuck(),
            });
        }
        if op == EvalOp::Compare {
            return self.boolean(self.compare(x, args[1])?.is_lt());
        }
        if op.is_list_op() {
            return self.list_builtin(op, args);
        }
        let lits: Option<Vec<_>> = args
            .iter()
            .map(|&t| match self.view(t).ok()? {
                TermData::Literal(l) => Some(l.clone()),
                _ => None,
            })
            .collect();
        let Some(lits) = lits else {
            return Ok(self.stuck());
        };
        let refs: Vec<_> = lits.iter().collect();
        match Lit::evaluate(op, &refs) {
            Some(lit) => self.literal(lit),
            None => Ok(self.stuck()),
        }
    }

    fn list_parts(&mut self, f: Term, mut list: Term) -> CheckResult<Option<(Vec<Term>, Term)>> {
        let left = match self.view(f)? {
            TermData::Node(c, _) => c.is_left_assoc(),
            _ => false,
        };
        let mut out = Vec::new();
        while let Some((g, b)) = self.unapply(list)? {
            let Some((head, a)) = self.unapply(g)? else {
                break;
            };
            if f != head {
                break;
            }
            if out.len() as u64 >= self.limits.calls {
                return Err(CheckError::Limit);
            }
            out.push(if left { b } else { a });
            list = if left { a } else { b };
        }
        let is_nil = generated::@$eo_is_list_nil@(self, f, list)?;
        if self.boolean_value(is_nil, false)? != Some(true) {
            return Ok(None);
        }
        Ok(Some((out, list)))
    }
    fn list_build(&mut self, f: Term, elems: &[Term], mut nil: Term) -> CheckResult<Term> {
        let left = match self.view(f)? {
            TermData::Node(c, _) => c.is_left_assoc(),
            _ => false,
        };
        for &e in elems.iter().rev() {
            let first = self.apply(f, if left { nil } else { e })?;
            nil = self.apply(first, if left { e } else { nil })?;
        }
        Ok(nil)
    }
    fn list_builtin(&mut self, op: EvalOp, a: &[Term]) -> CheckResult<Term> {
        let f = a[0];
        if op == EvalOp::Nil {
            return generated::@$eo_nil@(self, f, a[1]);
        }
        if op == EvalOp::ListRepeat {
            let Some(n) = self.object_index(a[2])? else {
                return Ok(self.stuck());
            };
            if u64::from(n) > self.limits.calls {
                return Err(CheckError::Limit);
            }
            let ty = generated::@$eo_typeof@(self, a[1])?;
            let nil = generated::@$eo_nil@(self, f, ty)?;
            return self.list_build(f, &vec![a[1]; n as usize], nil);
        }
        if op == EvalOp::Cons {
            let Some((mut tail, nil)) = self.list_parts(f, a[2])? else {
                return Ok(self.stuck());
            };
            tail.insert(0, a[1]);
            return self.list_build(f, &tail, nil);
        }
        let Some((mut xs, nil)) = self.list_parts(f, a[1])? else {
            if op == EvalOp::ListSingletonIntro {
                let ty = generated::@$eo_typeof@(self, a[1])?;
                let nil = generated::@$eo_nil@(self, f, ty)?;
                return self.list_build(f, &[a[1]], nil);
            }
            return Ok(self.stuck());
        };
        match op {
            EvalOp::ListLength => return self.numeral(Integer::from(xs.len())),
            EvalOp::ListNth => {
                return Ok(self
                    .object_index(a[2])?
                    .and_then(|n| xs.get(n as usize).copied())
                    .unwrap_or(self.stuck()));
            }
            EvalOp::ListFind => {
                return self.numeral(
                    xs.iter()
                        .position(|&x| x == a[2])
                        .map(Integer::from)
                        .unwrap_or_else(|| Integer::one().neg()),
                );
            }
            EvalOp::ListRev => xs.reverse(),
            EvalOp::ListSingletonElim => return Ok(if xs.len() == 1 { xs[0] } else { a[1] }),
            EvalOp::ListSingletonIntro => return Ok(a[1]),
            EvalOp::ListErase => {
                if let Some(i) = xs.iter().position(|&x| x == a[2]) {
                    xs.remove(i);
                }
            }
            EvalOp::ListEraseAll => xs.retain(|&x| x != a[2]),
            EvalOp::ListSetof => {
                let mut seen = std::collections::HashSet::new();
                xs.retain(|&x| seen.insert(x));
            }
            EvalOp::ListConcat
            | EvalOp::ListMinclude
            | EvalOp::ListMeq
            | EvalOp::ListDiff
            | EvalOp::ListInter => {
                let Some((ys, other_nil)) = self.list_parts(f, a[2])? else {
                    return Ok(self.stuck());
                };
                if other_nil != nil {
                    return Ok(self.stuck());
                }
                if op == EvalOp::ListConcat {
                    let left = match self.view(f)? {
                        TermData::Node(c, _) => c.is_left_assoc(),
                        _ => false,
                    };
                    if left {
                        let mut ys = ys;
                        ys.extend(xs);
                        xs = ys;
                    } else {
                        xs.extend(ys);
                    }
                } else {
                    let mut counts = HashMap::<Term, usize>::new();
                    for y in ys {
                        *counts.entry(y).or_default() += 1;
                    }
                    if op == EvalOp::ListMinclude || op == EvalOp::ListMeq {
                        for &x in &xs {
                            if let Some(n) = counts.get_mut(&x) {
                                *n = n.saturating_sub(1);
                            } else if op == EvalOp::ListMeq {
                                return self.boolean(false);
                            }
                        }
                        let contained = counts.values().all(|&n| n == 0);
                        if op == EvalOp::ListMeq && contained {
                            let ys = self
                                .list_parts(f, a[2])?
                                .ok_or(CheckError::InvalidConstructor)?
                                .0;
                            return self.boolean(xs.len() == ys.len());
                        }
                        return self.boolean(contained);
                    }
                    xs.retain(|x| {
                        let n = counts.entry(*x).or_default();
                        let found = *n > 0;
                        *n = n.saturating_sub(1);
                        found == (op == EvalOp::ListInter)
                    });
                }
            }
            _ => return Ok(self.stuck()),
        }
        self.list_build(f, &xs, nil)
    }

    /// Check the entire proof state machine, including typing, assumptions,
    /// step-pop, premise lookup and the final closed refutation test.
    pub fn check_refutation(&mut self, assumptions: Term, commands: Term) -> CheckResult<bool> {
        with_checker_stack(|| self.check_refutation_inner(assumptions, commands))
    }
    fn check_refutation_inner(&mut self, assumptions: Term, commands: Term) -> CheckResult<bool> {
        self.calls = 0;
        let answer = generated::@$eo_checker_is_refutation@(self, assumptions, commands)?;
        Ok(self.boolean_value(answer, true)? == Some(true))
    }
}

/// Keep recursive rule code on a deliberately sized stack. Errors and worker
/// failures remain values. Resource limits are checked before recursive calls.
pub fn with_checker_stack<T: Send>(f: impl FnOnce() -> CheckResult<T> + Send) -> CheckResult<T> {
    std::thread::scope(|scope| {
        std::thread::Builder::new()
            .stack_size(CHECKER_STACK_SIZE)
            .spawn_scoped(scope, f)
            .map_err(|_| CheckError::Worker)?
            .join()
            .map_err(|_| CheckError::Worker)?
    })
}

fn parse_int(s: &str) -> CheckResult<Integer> {
    Integer::parse(s, 10).ok_or(CheckError::InvalidNative)
}
pub fn parse_rat(s: &str) -> CheckResult<Rational> {
    Rational::parse(s).ok_or(CheckError::InvalidNative)
}

#[cfg(test)]
mod cache_tests {
    use super::*;

    #[test]
    fn invalid_cached_call_restores_depth_and_never_caches_an_error() {
        let mut s = Store::default();
        assert_eq!(
            generated::@$eo_typeof@(&mut s, Term(u32::MAX)),
            Err(CheckError::InvalidHandle)
        );
        assert_eq!(s.depth, 0);
        assert_eq!(s.cache_stats().type_entries, 0);
        let stuck = s.stuck();
        assert_eq!(generated::@$eo_typeof@(&mut s, stuck), Ok(stuck));
        let hits = s.cache_stats().type_hits;
        assert_eq!(generated::@$eo_typeof@(&mut s, stuck), Ok(stuck));
        assert_eq!(s.cache_stats().type_hits, hits + 1);
        assert_eq!(s.depth, 0);
    }
}
