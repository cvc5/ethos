//! Generated, parser-free proof checker. See functions.tsv for EO counterparts.
//!
//! The compiled checker establishes derivability in the supplied calculus.
//! A Logos soundness result additionally requires the translation side
//! conditions and refinement of this runtime. Neither is assumed here.
#![forbid(unsafe_code)]
#![allow(non_camel_case_types)]
#![allow(non_snake_case)]
// The checking functions are written in the plain subset of Rust that the
// verification tools translate: explicit matches and loops, not macros,
// closures or iterator adaptors.
#![allow(
    clippy::match_like_matches_macro,
    clippy::manual_map,
    clippy::question_mark,
    clippy::collapsible_if,
    clippy::collapsible_else_if
)]

mod bitvec;
mod cache;
mod eostring;
mod front;
#[allow(unreachable_code, unused_labels, unused_variables)]
// Uniform temporaries make evaluation order and refinement obligations explicit.
#[allow(
    clippy::let_and_return,
    clippy::almost_swapped,
    clippy::too_many_arguments,
    clippy::only_used_in_recursion
)]
pub mod generated;
pub mod kind;
mod lit;
#[allow(dead_code)] // A signature need not use every native operation.
mod native;
mod num;
#[allow(clippy::match_like_matches_macro)]
mod schema;
mod table;

pub use bitvec::BitVec;
pub use cache::CacheStats;
use cache::{Caches, ProgramId, TypeCacheKind};
pub use eostring::{EoString, NUM_CODES};
#[allow(unused_imports)]
pub(crate) use front::parse_int;
pub use front::{parse_rat, with_checker_stack};
pub use kind::{EvalOp, LitKind};
pub use lit::Lit;
pub use native::NativeOp;
pub use num::{Integer, Rational};
pub use schema::Constructor;
use native::is_less;
use table::{PairStack, TermCounts, fold, mix, slots_for};

#[derive(Clone, PartialEq, Eq)]
pub enum CheckError {
    InvalidHandle,
    InvalidConstructor,
    InvalidNative,
    /// An operation or a constant the runtime does not have. The number
    /// stands for its name, which `CheckError::unsupported_name` gives and
    /// which the error is printed with.
    UnsupportedNative(u32),
    Limit,
    Worker,
}
impl std::error::Error for CheckError {}
pub type CheckResult<T> = Result<T, CheckError>;

/// How the store represents the terms a constructor builds. The generator
/// says which it is for each constructor (`Constructor::embedding`), from
/// the constructor's name in the embedding of terms; the runtime compares no
/// names.
#[derive(Copy, Clone, Debug, PartialEq, Eq)]
pub enum Embedding {
    /// `$emb_Stuck`: the stuck term.
    Stuck,
    /// `$emb_Apply`: an application.
    Apply,
    /// `$emb_Boolean`, `$emb_Numeral`, `$emb_Rational`, `$emb_String`,
    /// `$emb_Binary`: an object literal, built from native values.
    Boolean,
    Numeral,
    Rational,
    Str,
    Binary,
    /// `$emb_UOp`, `$emb_UOp1`, ...: the view of a user operator with its
    /// indices as an operator applied to them.
    UOp,
    /// `$emb_Var`: a variable, which is data.
    Var,
    /// Any other constructor: data.
    Data,
}

/// What a round of a generated loop gives: the result, or the arguments of
/// the next round. (A program that calls itself last is compiled to a loop.)
pub enum Next<T> {
    Done(Term),
    Again(T),
}

/// What a step down the list of assumptions gives (the generated
/// `$eo_invoke_assume_list`): the state the list ends in, or a guard and a
/// term to push on the way back, with the rest of the list.
pub enum FoldStep {
    Done(Term),
    Push(Term, Term, Term),
}

/// An arena-local handle. Obtain handles through Store's constructors.
#[derive(Copy, Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
pub struct Term(u32);

/// The structural embedding. Native fields have a separate representation
/// from object-language literals. Nodes carry the generated constructor tag;
/// their child count is checked against the generated schema on construction.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum TermData {
    Stuck,
    Literal(Lit),
    Native(Lit),
    UserOp(Constructor),
    Apply(Term, Term),
    Node(Constructor, Vec<Term>),
}

#[derive(Copy, Clone, Debug)]
pub struct Limits {
    pub terms: u32,
    pub calls: u64,
    pub depth: u32,
}

pub(crate) const CHECKER_STACK_SIZE: usize = 256 * 1024 * 1024;
// A conservative space budget for each generated call, including its case
// helper and runtime calls. This is a default, not a static frame-size bound.
const DEFAULT_DEPTH: u32 = (CHECKER_STACK_SIZE / (16 * 1024)) as u32;

impl Default for Limits {
    fn default() -> Self {
        Self {
            terms: 10_000_000,
            calls: 10_000_000,
            // Allow ordinary deep terms on the 256 MiB checker stack.
            // Covered by deep-term regressions in debug and release builds.
            depth: DEFAULT_DEPTH,
        }
    }
}

/// What `destruct` found, before the native fields are interned.
enum Hit {
    Done(Option<Vec<Term>>),
    Raw(Lit),
    Binary(Integer, Integer),
}

/// The Logos verdict, including its translation side conditions. Returning
/// Correct is an executable result; formal Rust refinement remains separate.
#[derive(Copy, Clone, Debug, PartialEq, Eq)]
pub enum Verdict {
    Correct,
    Incorrect,
    Incomplete,
}

/// What a translation mask asks of an argument (Logos's
/// `ArgTranslationKind`). `Unknown` is a word of the table of masks that
/// is none of them.
#[derive(Copy, Clone, Debug, PartialEq, Eq)]
#[allow(dead_code)] // A signature without masks builds none.
pub(crate) enum ArgKind {
    Term,
    Type,
    WfTerm,
    WfElem,
    List,
    Unknown,
}

/// Monotonically growing, hash-consed arena. Hashes only say where a search
/// starts; equality is always checked, so collisions cannot identify
/// different terms.
pub struct Store {
    nodes: Vec<TermData>,
    /// The hash of each node's data, as its search uses it.
    hashes: Vec<u32>,
    /// The table of all terms, by their data: open addressing with linear
    /// probing. A slot is 0 or one more than a handle. The number of slots
    /// is a power of two and at least twice the number of nodes, so every
    /// search ends at an empty slot.
    slots: Vec<u32>,
    caches: Caches,
    limits: Limits,
    calls: u64,
    depth: u32,
    /// Jump pointers over state lists, for `state_nth`, indexed by
    /// term handle. The entry of a `cons` node, once computed, is its depth
    /// and one node further down the same list; the depth is the number of
    /// `cons` nodes from the node to the end of its list, so it is never 0,
    /// and depth 0 means "not computed". The vector is only as long as the
    /// largest handle with an entry. Correctness rests on one invariant: an
    /// entry `(d, j)` of node `t` has `d` equal to the depth of `t`, and `j`
    /// is what following tails from `t` reaches after between one and `d`
    /// steps (the list's end being at depth zero). Which such `j` is chosen
    /// only affects speed.
    state_jumps: Vec<(u32, Term)>,
}
impl Default for Store {
    fn default() -> Self {
        Self::new(Limits::default())
    }
}
impl Store {
    pub fn new(limits: Limits) -> Self {
        let stuck = TermData::Stuck;
        let hash = Self::data_hash(&stuck);
        let mut store = Self {
            nodes: vec![stuck],
            hashes: vec![hash],
            slots: vec![0; slots_for(1)],
            caches: Caches::new(limits.terms as usize),
            limits,
            calls: 0,
            depth: 0,
            state_jumps: Vec::new(),
        };
        store.place(Term(0), hash);
        store
    }
    pub fn stuck(&self) -> Term {
        Term(0)
    }
    pub fn view(&self, t: Term) -> CheckResult<&TermData> {
        self.nodes
            .get(t.0 as usize)
            .ok_or(CheckError::InvalidHandle)
    }
    fn intern(&mut self, data: TermData) -> CheckResult<Term> {
        let hash = Self::data_hash(&data);
        if let Some(t) = self.find(&data, hash) {
            return Ok(t);
        }
        // A slot holds a handle plus one, so the last handle is not used.
        if self.nodes.len() >= u32::MAX as usize {
            return Err(CheckError::Limit);
        }
        let n = self.nodes.len() as u32;
        if n >= self.limits.terms {
            return Err(CheckError::Limit);
        }
        let t = Term(n);
        self.nodes.push(data);
        self.hashes.push(hash);
        if self.slots.len() / 2 < self.nodes.len() {
            self.grow();
        } else {
            self.place(t, hash);
        }
        self.caches.push_term();
        Ok(t)
    }
    /// The hash of a term's data. Equal data has equal hashes.
    fn data_hash(data: &TermData) -> u32 {
        let h = match data {
            TermData::Stuck => 0,
            TermData::Literal(literal) => mix(1, literal.hash_code()),
            TermData::Native(literal) => mix(2, literal.hash_code()),
            TermData::UserOp(c) => mix(3, u64::from(c.code())),
            TermData::Apply(f, a) => mix(mix(4, u64::from(f.0)), u64::from(a.0)),
            TermData::Node(c, fields) => {
                let mut h = mix(5, u64::from(c.code()));
                let mut i = 0;
                while i < fields.len() {
                    h = mix(h, u64::from(fields[i].0));
                    i += 1;
                }
                h
            }
        };
        fold(h)
    }
    /// Whether two terms have the same data.
    fn same_data(a: &TermData, b: &TermData) -> bool {
        match a {
            TermData::Stuck => match b {
                TermData::Stuck => true,
                _ => false,
            },
            TermData::Literal(x) => match b {
                TermData::Literal(y) => x == y,
                _ => false,
            },
            TermData::Native(x) => match b {
                TermData::Native(y) => x == y,
                _ => false,
            },
            TermData::UserOp(c) => match b {
                TermData::UserOp(d) => c.code() == d.code(),
                _ => false,
            },
            TermData::Apply(f, x) => match b {
                TermData::Apply(g, y) => f.0 == g.0 && x.0 == y.0,
                _ => false,
            },
            TermData::Node(c, xs) => match b {
                TermData::Node(d, ys) => c.code() == d.code() && Self::same_terms(xs, ys),
                _ => false,
            },
        }
    }
    fn same_terms(a: &[Term], b: &[Term]) -> bool {
        if a.len() != b.len() {
            return false;
        }
        let mut same = true;
        let mut i = 0;
        while i < a.len() {
            if a[i].0 != b[i].0 {
                same = false;
            }
            i += 1;
        }
        same
    }
    /// The term with this data, if the store has it. `hash` is the data's.
    fn find(&self, data: &TermData, hash: u32) -> Option<Term> {
        let mask = self.slots.len() - 1;
        let mut i = (hash as usize) & mask;
        let mut found = None;
        let mut searching = true;
        while searching {
            let s = self.slots[i];
            if s == 0 {
                searching = false;
            } else {
                let t = (s - 1) as usize;
                if self.hashes[t] == hash && Self::same_data(&self.nodes[t], data) {
                    found = Some(Term(s - 1));
                    searching = false;
                } else {
                    i = (i + 1) & mask;
                }
            }
        }
        found
    }
    /// Puts a term that is not in the table into it.
    fn place(&mut self, t: Term, hash: u32) {
        let mask = self.slots.len() - 1;
        let mut i = (hash as usize) & mask;
        while self.slots[i] != 0 {
            i = (i + 1) & mask;
        }
        self.slots[i] = t.0 + 1;
    }
    /// Twice the slots, with every node placed again.
    fn grow(&mut self) {
        self.slots = vec![0; self.slots.len() * 2];
        let mut t = 0;
        while t < self.hashes.len() {
            self.place(Term(t as u32), self.hashes[t]);
            t += 1;
        }
    }
    /// Caches contain only completed pure results and remain valid as the
    /// arena grows and across proof checks. Disable them to measure a baseline.
    pub fn set_caching(&mut self, enabled: bool) {
        self.caches.set_enabled(enabled);
    }
    pub fn clear_caches(&mut self) {
        self.caches.clear();
    }
    pub fn cache_stats(&self) -> CacheStats {
        self.caches.stats()
    }
    pub(crate) fn cached_type(
        &mut self,
        which: TypeCacheKind,
        term: Term,
    ) -> CheckResult<Option<Term>> {
        self.view(term)?;
        Ok(self.caches.type_get(which, term))
    }
    pub(crate) fn cache_type(
        &mut self,
        which: TypeCacheKind,
        term: Term,
        result: Term,
    ) -> CheckResult<()> {
        self.view(term)?;
        self.view(result)?;
        self.caches.type_insert(which, term, result);
        Ok(())
    }
    pub(crate) fn cached_program(
        &mut self,
        program: ProgramId,
        args: &[Term],
    ) -> CheckResult<Option<Term>> {
        let mut i = 0;
        while i < args.len() {
            self.view(args[i])?;
            i += 1;
        }
        Ok(self.caches.program_get(program, args))
    }
    pub(crate) fn cache_program(
        &mut self,
        program: ProgramId,
        args: &[Term],
        result: Term,
    ) -> CheckResult<()> {
        let mut i = 0;
        while i < args.len() {
            self.view(args[i])?;
            i += 1;
        }
        self.view(result)?;
        self.caches.program_insert(program, args, result);
        Ok(())
    }
    pub fn literal(&mut self, literal: Lit) -> CheckResult<Term> {
        // Logos has one rational and one binary constructor.
        let literal = match literal {
            Lit::Decimal(q) => Lit::Rational(q),
            Lit::Hex(b) => Lit::Binary(b),
            l => l,
        };
        self.intern(TermData::Literal(literal))
    }
    pub fn raw(&mut self, literal: Lit) -> CheckResult<Term> {
        self.intern(TermData::Native(literal))
    }
    pub fn boolean(&mut self, b: bool) -> CheckResult<Term> {
        self.literal(Lit::Boolean(b))
    }
    pub fn numeral(&mut self, n: Integer) -> CheckResult<Term> {
        self.literal(Lit::Numeral(n))
    }
    pub fn is_stuck(&self, t: Term) -> CheckResult<bool> {
        Ok(matches!(self.view(t)?, TermData::Stuck))
    }
    pub fn boolean_value(&self, t: Term, native: bool) -> CheckResult<Option<bool>> {
        Ok(match (native, self.view(t)?) {
            (false, TermData::Literal(Lit::Boolean(b))) | (true, TermData::Native(Lit::Boolean(b))) => {
                Some(*b)
            }
            _ => None,
        })
    }
    /// Whether `t` is the native boolean `true`.
    pub(crate) fn is_native_true(&self, t: Term) -> CheckResult<bool> {
        Ok(match self.boolean_value(t, true)? {
            Some(true) => true,
            _ => false,
        })
    }
    pub fn apply(&mut self, f: Term, a: Term) -> CheckResult<Term> {
        if self.is_stuck(f)? || self.is_stuck(a)? {
            return Ok(self.stuck());
        }
        self.intern(TermData::Apply(f, a))
    }
    pub fn unapply(&self, t: Term) -> CheckResult<Option<(Term, Term)>> {
        Ok(match self.view(t)? {
            TermData::Apply(f, a) => Some((*f, *a)),
            _ => None,
        })
    }
    /// Whether `t` is built by the constructor `c`, as data. `None` is a
    /// constructor the signature does not have.
    pub(crate) fn is_node(&self, t: Term, c: Option<Constructor>) -> CheckResult<bool> {
        Ok(match (self.view(t)?, c) {
            (TermData::Node(d, _), Some(c)) => d.code() == c.code(),
            _ => false,
        })
    }
    /// The fields of `t` if it is built by the constructor `c`, as data.
    pub(crate) fn node_fields(
        &self,
        t: Term,
        c: Option<Constructor>,
    ) -> CheckResult<Option<Vec<Term>>> {
        Ok(match (self.view(t)?, c) {
            (TermData::Node(d, fs), Some(c)) if d.code() == c.code() => Some(fs.clone()),
            _ => None,
        })
    }
    /// Whether `t` is a variable (`$emb_Var`).
    fn is_variable(&self, t: Term) -> CheckResult<bool> {
        Ok(match self.view(t)? {
            TermData::Node(c, _) => match c.embedding() {
                Embedding::Var => true,
                _ => false,
            },
            _ => false,
        })
    }
    pub fn construct(&mut self, c: Constructor, args: &[Term]) -> CheckResult<Term> {
        if c.arity() != args.len() {
            return Err(CheckError::InvalidConstructor);
        }
        // (not a loop here: `construct` calls itself through
        // `construct_user`, and Aeneas's Lean does not take a loop whose
        // function is called again from inside it)
        self.check_handles(args)?;
        let e = c.embedding();
        match e {
            Embedding::UOp => self.construct_user(args),
            Embedding::Stuck if args.is_empty() => Ok(self.stuck()),
            Embedding::Apply if args.len() == 2 => self.apply(args[0], args[1]),
            Embedding::Boolean | Embedding::Numeral | Embedding::Rational | Embedding::Str
                if args.len() == 1 =>
            {
                self.construct_literal(e, args[0])
            }
            Embedding::Binary if args.len() == 2 => self.construct_binary(args[0], args[1]),
            // All other constructors are data, including CState.Stuck.
            _ => self.intern(TermData::Node(c, args.to_vec())),
        }
    }
    /// A user operator from its wrapper view: the operator, then its fields.
    fn construct_user(&mut self, args: &[Term]) -> CheckResult<Term> {
        if args.is_empty() {
            return Err(CheckError::InvalidConstructor);
        }
        let user = match self.view(args[0])? {
            TermData::UserOp(user) => *user,
            _ => return Err(CheckError::InvalidConstructor),
        };
        self.construct(user, &args[1..])
    }
    /// An object literal from the native value `v` of its kind.
    fn construct_literal(&mut self, e: Embedding, v: Term) -> CheckResult<Term> {
        let literal = match self.view(v)? {
            TermData::Native(literal) => literal,
            _ => return Err(CheckError::InvalidNative),
        };
        let which = match literal {
            Lit::Boolean(_) => Embedding::Boolean,
            Lit::Numeral(_) => Embedding::Numeral,
            Lit::Rational(_) => Embedding::Rational,
            Lit::Str(_) => Embedding::Str,
            _ => Embedding::Data,
        };
        let valid = match e {
            Embedding::Data => false,
            _ => e == which,
        };
        if !valid {
            return Err(CheckError::InvalidNative);
        }
        let literal = literal.clone();
        self.literal(literal)
    }
    /// A binary literal from its native width and value.
    fn construct_binary(&mut self, w: Term, v: Term) -> CheckResult<Term> {
        let w = self.raw_int(w)?;
        let v = self.raw_int(v)?;
        if !w.fits_u32() {
            return Err(CheckError::Limit);
        }
        self.literal(Lit::Binary(BitVec::new(w.to_u32(), &v)))
    }
    pub fn destruct(&mut self, c: Constructor, t: Term) -> CheckResult<Option<Vec<Term>>> {
        // Matching by reference: only what is returned is copied.
        let e = c.embedding();
        if let Embedding::UOp = e {
            return self.destruct_user(c, t);
        }
        let hit = match self.view(t)? {
            TermData::Stuck => match e {
                Embedding::Stuck => Hit::Done(Some(Vec::new())),
                _ => Hit::Done(None),
            },
            TermData::Apply(f, a) => match e {
                Embedding::Apply => Hit::Done(Some(vec![*f, *a])),
                _ => Hit::Done(None),
            },
            TermData::Literal(literal) => Self::destruct_literal(e, literal),
            TermData::Node(d, fields) if c.code() == d.code() => Hit::Done(Some(fields.clone())),
            _ => Hit::Done(None),
        };
        match hit {
            Hit::Done(r) => Ok(r),
            Hit::Raw(literal) => {
                let v = self.raw(literal)?;
                Ok(Some(vec![v]))
            }
            Hit::Binary(size, value) => {
                let size = self.raw(Lit::Numeral(size))?;
                let value = self.raw(Lit::Numeral(value))?;
                Ok(Some(vec![size, value]))
            }
        }
    }
    /// The native fields of an object literal, if `e` is its kind.
    fn destruct_literal(e: Embedding, literal: &Lit) -> Hit {
        let which = match literal {
            Lit::Boolean(_) => Embedding::Boolean,
            Lit::Numeral(_) => Embedding::Numeral,
            Lit::Rational(_) => Embedding::Rational,
            Lit::Str(_) => Embedding::Str,
            Lit::Binary(_) => Embedding::Binary,
            _ => Embedding::Data,
        };
        let hit = match e {
            Embedding::Data => false,
            _ => e == which,
        };
        if !hit {
            return Hit::Done(None);
        }
        match literal {
            Lit::Binary(b) => Hit::Binary(Integer::from(b.size()), b.value().clone()),
            _ => Hit::Raw(literal.clone()),
        }
    }
    /// The wrapper view of a user operator: the operator, then its fields.
    fn destruct_user(&mut self, c: Constructor, t: Term) -> CheckResult<Option<Vec<Term>>> {
        let (user, fields) = match self.view(t)? {
            TermData::Node(user, fields) if user.is_user() && fields.len() + 1 == c.arity() => {
                (*user, fields.clone())
            }
            _ => return Ok(None),
        };
        let op = self.intern(TermData::UserOp(user))?;
        let mut args = Vec::with_capacity(fields.len() + 1);
        args.push(op);
        args.extend_from_slice(&fields);
        Ok(Some(args))
    }
    /// The element lookup of `$eo_state_proven_nth` of the checking loop
    /// (eo_desugar_checker.eo), which the generator compiles to a call of
    /// this and, for an element, of the program's `proven`. The program walks the
    /// state list one element at a time, creating and interning a native
    /// numeral at each; on long proofs that walk dominates. This finds the
    /// same element in O(log n) steps with jump pointers, and charges the
    /// same budget as the walk (one `tick` per element visited, failing with
    /// `Limit` exactly when the walk would). Results:
    /// - the index-th element (from 0) of a list with more elements is
    ///   `Some(element)`, of which the program gives `proven(element)`;
    /// - a negative index, or one past the end, is `None` after walking the
    ///   whole list, for which the program gives the object literal `true`;
    /// - a state that is not a `cons` is `None` too;
    /// - an index that is not a native numeral, on a `cons`, is
    ///   `InvalidNative`.
    pub(crate) fn state_nth(
        &mut self,
        cons: Constructor,
        state: Term,
        index: Term,
    ) -> CheckResult<Option<Term>> {
        let depth = self.state_depth(cons, state)?;
        if depth == 0 {
            self.charge(1)?;
            return Ok(None);
        }
        // None: not a native numeral; Some(None): never reaches 0.
        let n: Option<Option<u64>> = match self.view(index)? {
            TermData::Native(Lit::Numeral(n)) => Some(if n.sgn() >= 0 && n.fits_u32() {
                Some(u64::from(n.to_u32()))
            } else {
                None
            }),
            _ => None,
        };
        match n {
            None => {
                self.charge(1)?;
                Err(CheckError::InvalidNative)
            }
            Some(Some(k)) if k < u64::from(depth) => {
                self.charge(k + 1)?;
                let node = self.state_ancestor(cons, state, depth - k as u32)?;
                match self.view(node)? {
                    TermData::Node(_, fields) => Ok(Some(fields[0])),
                    _ => Err(CheckError::InvalidNative),
                }
            }
            Some(_) => {
                self.charge(u64::from(depth) + 1)?;
                Ok(None)
            }
        }
    }
    /// `count` ticks at once, failing exactly when `count` calls of `tick`
    /// would.
    fn charge(&mut self, count: u64) -> CheckResult<()> {
        if self.calls.saturating_add(count) > self.limits.calls {
            self.calls = self.limits.calls;
            return Err(CheckError::Limit);
        }
        self.calls += count;
        Ok(())
    }
    /// The tail of a `cons` node, or None if `t` is not one.
    fn state_tail(&self, cons: Constructor, t: Term) -> CheckResult<Option<Term>> {
        Ok(match self.view(t)? {
            TermData::Node(c, fields) if c.code() == cons.code() && fields.len() == 2 => {
                Some(fields[1])
            }
            _ => None,
        })
    }
    /// The jump-pointer entry of `t`, if computed.
    fn state_jump(&self, t: Term) -> Option<(u32, Term)> {
        let i = t.0 as usize;
        if i < self.state_jumps.len() {
            let entry = self.state_jumps[i];
            if entry.0 > 0 { Some(entry) } else { None }
        } else {
            None
        }
    }
    /// The depth in the jump-pointer entry of `t`, or 0 if it has none.
    fn state_jump_depth(&self, t: Term) -> u32 {
        match self.state_jump(t) {
            Some((d, _)) => d,
            None => 0,
        }
    }
    fn set_state_jump(&mut self, t: Term, entry: (u32, Term)) {
        let i = t.0 as usize;
        if self.state_jumps.len() <= i {
            self.state_jumps.resize(i + 1, (0, Term(0)));
        }
        self.state_jumps[i] = entry;
    }
    /// The number of `cons` nodes from `t` to the end of its list (0 if `t`
    /// is not a `cons`), computing jump pointers for the nodes on the way
    /// that have none yet, from the bottom up.
    fn state_depth(&mut self, cons: Constructor, t: Term) -> CheckResult<u32> {
        let mut pending = PairStack::new();
        let mut x = t;
        let mut base = loop {
            if let Some((d, _)) = self.state_jump(x) {
                break d;
            }
            match self.state_tail(cons, x)? {
                Some(tail) => {
                    pending.push((x, tail));
                    x = tail;
                }
                None => break 0,
            }
        };
        // Myers's jump pointers: a node jumps two jumps of its tail when the
        // tail's two jumps span equal distances, and to its tail otherwise.
        // That keeps each node's jump at most a power-of-two-ish distance,
        // so finding an ancestor takes O(log depth) steps.
        while let Some((node, tail)) = pending.pop() {
            base += 1;
            let jump = match self.state_jump(tail) {
                Some((dt, jt)) => match self.state_jump(jt) {
                    Some((dj, jj)) => {
                        let djj = self.state_jump_depth(jj);
                        if dt - dj == dj - djj { jj } else { tail }
                    }
                    None => tail,
                },
                None => tail,
            };
            self.set_state_jump(node, (base, jump));
        }
        Ok(base)
    }
    /// The node at depth `target` (>= 1) below `t`, a `cons` node of depth at
    /// least `target` whose jump pointers are computed.
    fn state_ancestor(&self, cons: Constructor, t: Term, target: u32) -> CheckResult<Term> {
        let mut x = t;
        loop {
            let Some((d, jump)) = self.state_jump(x) else {
                return Err(CheckError::InvalidNative);
            };
            if d == target {
                return Ok(x);
            }
            let dj = self.state_jump_depth(jump);
            x = if dj >= target {
                jump
            } else {
                match self.state_tail(cons, x)? {
                    Some(tail) => tail,
                    None => return Err(CheckError::InvalidNative),
                }
            };
        }
    }
    fn raw_int(&self, t: Term) -> CheckResult<Integer> {
        match self.view(t)? {
            TermData::Native(Lit::Numeral(n)) => Ok(n.clone()),
            _ => Err(CheckError::InvalidNative),
        }
    }
    fn raw_rat(&self, t: Term) -> CheckResult<Rational> {
        match self.view(t)? {
            TermData::Native(Lit::Rational(n)) => Ok(n.clone()),
            _ => Err(CheckError::InvalidNative),
        }
    }
    pub(crate) fn object_index(&self, t: Term) -> CheckResult<Option<u32>> {
        Ok(match self.view(t)? {
            TermData::Literal(Lit::Numeral(n)) if n.fits_u32() => Some(n.to_u32()),
            _ => None,
        })
    }
    /// The place of a term's constructor in LogosTermOrder.
    fn order_key(d: &TermData) -> CheckResult<(usize, usize)> {
        let e = match d {
            TermData::Stuck => Embedding::Stuck,
            TermData::Apply(..) => Embedding::Apply,
            TermData::Literal(Lit::Boolean(_)) => Embedding::Boolean,
            TermData::Literal(Lit::Numeral(_)) => Embedding::Numeral,
            TermData::Literal(Lit::Rational(_) | Lit::Decimal(_)) => Embedding::Rational,
            TermData::Literal(Lit::Str(_)) => Embedding::Str,
            TermData::Literal(Lit::Binary(_) | Lit::Hex(_)) => Embedding::Binary,
            TermData::Node(c, _) => return Ok(c.order_key()),
            TermData::Native(_) => return Ok((0, 0)),
            TermData::UserOp(c) => return Ok(c.order_key()),
        };
        match Constructor::of_embedding(e) {
            Some(c) => Ok(c.order_key()),
            None => Err(CheckError::InvalidConstructor),
        }
    }
    /// LogosTermOrder: constructor index, then fields from left to right.
    /// It does not depend on insertion order in the arena or hash values.
    pub fn compare(&self, a: Term, b: Term) -> CheckResult<std::cmp::Ordering> {
        use std::cmp::Ordering;
        // the pairs still to compare, the next one last
        let mut todo = PairStack::new();
        todo.push((a, b));
        let mut result = Ordering::Equal;
        let mut more = true;
        while more {
            match todo.pop() {
                None => more = false,
                Some((a, b)) => match self.compare_step(a, b, &mut todo)? {
                    Ordering::Equal => {}
                    order => {
                        result = order;
                        more = false;
                    }
                },
            }
        }
        Ok(result)
    }
    /// Compares the constructors of two terms and, if they are the same,
    /// their literals, or adds their fields to the pairs to compare.
    fn compare_step(
        &self,
        a: Term,
        b: Term,
        todo: &mut PairStack,
    ) -> CheckResult<std::cmp::Ordering> {
        use std::cmp::Ordering;
        if a == b {
            return Ok(Ordering::Equal);
        }
        let a = self.view(a)?;
        let b = self.view(b)?;
        let ka = Self::order_key(a)?;
        let kb = Self::order_key(b)?;
        let tags = match ka.0.cmp(&kb.0) {
            Ordering::Equal => ka.1.cmp(&kb.1),
            order => order,
        };
        match tags {
            Ordering::Equal => {}
            _ => return Ok(tags),
        }
        match a {
            TermData::Literal(x) => match b {
                TermData::Literal(y) => literal_cmp(x, y),
                _ => Err(CheckError::InvalidConstructor),
            },
            TermData::Native(x) => match b {
                TermData::Native(y) => literal_cmp(x, y),
                _ => Err(CheckError::InvalidConstructor),
            },
            TermData::Apply(af, aa) => match b {
                TermData::Apply(bf, ba) => {
                    todo.push((*aa, *ba));
                    todo.push((*af, *bf));
                    Ok(Ordering::Equal)
                }
                _ => Err(CheckError::InvalidConstructor),
            },
            TermData::UserOp(_) => match b {
                TermData::UserOp(_) => Ok(Ordering::Equal),
                _ => Err(CheckError::InvalidConstructor),
            },
            TermData::Node(_, xs) => match b {
                TermData::Node(_, ys) => {
                    if xs.len() != ys.len() {
                        return Err(CheckError::InvalidConstructor);
                    }
                    let mut i = xs.len();
                    while i > 0 {
                        i -= 1;
                        todo.push((xs[i], ys[i]));
                    }
                    Ok(Ordering::Equal)
                }
                _ => Err(CheckError::InvalidConstructor),
            },
            TermData::Stuck => Err(CheckError::InvalidConstructor),
        }
    }
    pub(crate) fn enter(&mut self) -> CheckResult<()> {
        if self.depth >= self.limits.depth || self.calls >= self.limits.calls {
            return Err(CheckError::Limit);
        }
        self.depth += 1;
        self.calls += 1;
        Ok(())
    }
    pub(crate) fn tick(&mut self) -> CheckResult<()> {
        if self.calls >= self.limits.calls {
            return Err(CheckError::Limit);
        }
        self.calls += 1;
        Ok(())
    }
    pub(crate) fn leave(&mut self) {
        self.depth -= 1;
    }

    /// Ethos-style primitive evaluation over already evaluated values.
    /// Stuck is explicit; recognizers and IsOk/IsEq return false on it.
    /// (The list operators are not here: they call generated functions,
    /// and are in lists.rs, above what they call. `builtin` there takes
    /// any operator.)
    pub(crate) fn builtin_core(&mut self, op: EvalOp, args: &[Term]) -> CheckResult<Term> {
        if !Self::takes(op, args.len()) {
            return Ok(self.stuck());
        }
        self.check_handles(args)?;
        let x = args[0];
        match op {
            EvalOp::IsOk => {
                let stuck = self.is_stuck(x)?;
                self.boolean(!stuck)
            }
            EvalOp::IsEq => {
                let equal = !self.is_stuck(x)? && !self.is_stuck(args[1])? && x == args[1];
                self.boolean(equal)
            }
            EvalOp::Eq => {
                if self.any_stuck(args) {
                    Ok(self.stuck())
                } else {
                    self.boolean(x == args[1])
                }
            }
            EvalOp::IfThenElse => Ok(match self.boolean_value(x, false)? {
                Some(true) => args[1],
                Some(false) => args[2],
                None => self.stuck(),
            }),
            EvalOp::Requires => Ok(if x == args[1] && !self.is_stuck(x)? {
                args[2]
            } else {
                self.stuck()
            }),
            // Logos's recognizers are total predicates, including on Stuck.
            EvalOp::IsZ
            | EvalOp::IsQ
            | EvalOp::IsBin
            | EvalOp::IsStr
            | EvalOp::IsBool
            | EvalOp::IsVar => {
                let b = self.recognizes(op, x)?;
                self.boolean(b)
            }
            _ => self.builtin_strict(op, args),
        }
    }
    /// Whether an operator takes this number of arguments.
    pub(crate) fn takes(op: EvalOp, count: usize) -> bool {
        let arity = match op {
            EvalOp::IsOk
            | EvalOp::Hash
            | EvalOp::TypeOf
            | EvalOp::NameOf
            | EvalOp::Not
            | EvalOp::Neg
            | EvalOp::IsNeg
            | EvalOp::Length
            | EvalOp::ToInt
            | EvalOp::ToRat
            | EvalOp::ToString
            | EvalOp::IsZ
            | EvalOp::IsQ
            | EvalOp::IsBin
            | EvalOp::IsStr
            | EvalOp::IsBool
            | EvalOp::IsVar
            | EvalOp::DtConstructors
            | EvalOp::DtSelectors => 1,
            EvalOp::IfThenElse
            | EvalOp::Requires
            | EvalOp::Cons
            | EvalOp::ListConcat
            | EvalOp::ListNth
            | EvalOp::ListFind
            | EvalOp::ListErase
            | EvalOp::ListEraseAll
            | EvalOp::ListMinclude
            | EvalOp::ListMeq
            | EvalOp::ListDiff
            | EvalOp::ListInter
            | EvalOp::ListRepeat
            | EvalOp::Extract => 3,
            _ => 2,
        };
        if op.is_nary() { count >= 2 } else { count == arity }
    }
    /// The operators that are stuck when an argument is.
    fn builtin_strict(&mut self, op: EvalOp, args: &[Term]) -> CheckResult<Term> {
        if self.any_stuck(args) {
            return Ok(self.stuck());
        }
        match op {
            EvalOp::NameOf => self.name_of(args[0]),
            EvalOp::Compare => {
                let order = self.compare(args[0], args[1])?;
                self.boolean(is_less(order))
            }
            _ => {
                if op.is_list_op() {
                    // not an operator of this function
                    Err(CheckError::InvalidNative)
                } else {
                    self.builtin_literal(op, args)
                }
            }
        }
    }
    /// The name of a variable, which is its first field.
    fn name_of(&mut self, x: Term) -> CheckResult<Term> {
        if !self.is_variable(x)? {
            return Ok(self.stuck());
        }
        Ok(match self.view(x)? {
            TermData::Node(_, fields) => fields[0],
            _ => self.stuck(),
        })
    }
    /// An operator on literals.
    fn builtin_literal(&mut self, op: EvalOp, args: &[Term]) -> CheckResult<Term> {
        let lits = match self.literals(args) {
            Some(lits) => lits,
            None => return Ok(self.stuck()),
        };
        match Lit::evaluate(op, &lits) {
            Some(literal) => self.literal(literal),
            None => Ok(self.stuck()),
        }
    }
    /// Refuses a handle that is not of this store.
    pub(crate) fn check_handles(&self, args: &[Term]) -> CheckResult<()> {
        let mut i = 0;
        while i < args.len() {
            self.view(args[i])?;
            i += 1;
        }
        Ok(())
    }
    /// Whether one of the terms is stuck (or not of this store).
    pub(crate) fn any_stuck(&self, args: &[Term]) -> bool {
        let mut any = false;
        let mut i = 0;
        while i < args.len() {
            if self.stuck_or_foreign(args[i]) {
                any = true;
            }
            i += 1;
        }
        any
    }
    /// Whether the term is stuck (or not of this store).
    fn stuck_or_foreign(&self, t: Term) -> bool {
        match self.view(t) {
            Ok(TermData::Stuck) => true,
            Ok(_) => false,
            Err(_) => true,
        }
    }
    /// The literal that the term is, if it is an object literal.
    fn literal_of(&self, t: Term) -> Option<Lit> {
        match self.view(t) {
            Ok(TermData::Literal(literal)) => Some(literal.clone()),
            _ => None,
        }
    }
    /// Whether `x` is what the recognizer `op` recognizes.
    fn recognizes(&self, op: EvalOp, x: Term) -> CheckResult<bool> {
        if op == EvalOp::IsVar {
            return self.is_variable(x);
        }
        Ok(match self.view(x)? {
            TermData::Literal(literal) => match literal {
                Lit::Numeral(_) => op == EvalOp::IsZ,
                Lit::Rational(_) => op == EvalOp::IsQ,
                Lit::Binary(_) => op == EvalOp::IsBin,
                Lit::Str(_) => op == EvalOp::IsStr,
                Lit::Boolean(_) => op == EvalOp::IsBool,
                _ => false,
            },
            _ => false,
        })
    }
    /// The literals that the terms are, if they all are object literals.
    fn literals(&self, args: &[Term]) -> Option<Vec<Lit>> {
        let mut lits = Vec::with_capacity(args.len());
        let mut all = true;
        let mut i = 0;
        while i < args.len() {
            match self.literal_of(args[i]) {
                Some(literal) => lits.push(literal),
                None => all = false,
            }
            i += 1;
        }
        if all { Some(lits) } else { None }
    }
}

/// The order of two literals of one kind: booleans, numbers, rationals by
/// numerator and then denominator, strings by code points, bit-vectors by
/// width and then value.
fn literal_cmp(a: &Lit, b: &Lit) -> CheckResult<std::cmp::Ordering> {
    use std::cmp::Ordering;
    match a {
        Lit::Boolean(a) => match b {
            Lit::Boolean(b) => Ok(if *a == *b {
                Ordering::Equal
            } else if *b {
                Ordering::Less
            } else {
                Ordering::Greater
            }),
            _ => Err(CheckError::InvalidNative),
        },
        Lit::Numeral(a) => match b {
            Lit::Numeral(b) => Ok(a.cmp(b)),
            _ => Err(CheckError::InvalidNative),
        },
        Lit::Rational(a) => match b {
            Lit::Rational(b) => Ok(match a.numerator().cmp(&b.numerator()) {
                Ordering::Equal => a.denominator().cmp(&b.denominator()),
                order => order,
            }),
            _ => Err(CheckError::InvalidNative),
        },
        Lit::Str(a) => match b {
            Lit::Str(b) => Ok(code_points_cmp(a.code_points(), b.code_points())),
            _ => Err(CheckError::InvalidNative),
        },
        Lit::Binary(a) => match b {
            Lit::Binary(b) => Ok(match a.size().cmp(&b.size()) {
                Ordering::Equal => a.value().cmp(b.value()),
                order => order,
            }),
            _ => Err(CheckError::InvalidNative),
        },
        _ => Err(CheckError::InvalidNative),
    }
}
/// The order of two sequences of code points: by the first place where
/// they differ, a proper prefix first.
fn code_points_cmp(a: &[u32], b: &[u32]) -> std::cmp::Ordering {
    use std::cmp::Ordering;
    let mut order = Ordering::Equal;
    let mut i = 0;
    let mut more = true;
    while more {
        if i == a.len() || i == b.len() {
            order = a.len().cmp(&b.len());
            more = false;
        } else if a[i] != b[i] {
            order = a[i].cmp(&b[i]);
            more = false;
        } else {
            i += 1;
        }
    }
    order
}
/// Adds the terms of `from` to `to`.
pub(crate) fn append_terms(to: &mut Vec<Term>, from: &[Term]) {
    let mut i = 0;
    while i < from.len() {
        to.push(from[i]);
        i += 1;
    }
}
/// The first place of `x` in `xs`.
pub(crate) fn position(xs: &[Term], x: Term) -> Option<usize> {
    let mut found = None;
    let mut i = xs.len();
    while i > 0 {
        i -= 1;
        if xs[i] == x {
            found = Some(i);
        }
    }
    found
}
/// The terms in the opposite order.
pub(crate) fn reversed(xs: &[Term]) -> Vec<Term> {
    let mut out = Vec::with_capacity(xs.len());
    let mut i = xs.len();
    while i > 0 {
        i -= 1;
        out.push(xs[i]);
    }
    out
}
/// The terms without the first occurrence of `x`.
pub(crate) fn without_first(xs: &[Term], x: Term) -> Vec<Term> {
    let mut out = Vec::with_capacity(xs.len());
    let mut erased = false;
    let mut i = 0;
    while i < xs.len() {
        if !erased && xs[i] == x {
            erased = true;
        } else {
            out.push(xs[i]);
        }
        i += 1;
    }
    out
}
/// The terms without any occurrence of `x`.
pub(crate) fn without(xs: &[Term], x: Term) -> Vec<Term> {
    let mut out = Vec::with_capacity(xs.len());
    let mut i = 0;
    while i < xs.len() {
        if xs[i] != x {
            out.push(xs[i]);
        }
        i += 1;
    }
    out
}
/// The first occurrence of each term, in order.
pub(crate) fn first_occurrences(xs: &[Term]) -> Vec<Term> {
    let mut seen = TermCounts::new(xs.len());
    let mut out = Vec::new();
    let mut i = 0;
    while i < xs.len() {
        if seen.entry(xs[i]).is_none() {
            seen.add(xs[i]);
            out.push(xs[i]);
        }
        i += 1;
    }
    out
}
/// The terms of `ys` counted, as a multiset.
fn multiset(ys: &[Term]) -> TermCounts {
    let mut counts = TermCounts::new(ys.len());
    let mut i = 0;
    while i < ys.len() {
        counts.add(ys[i]);
        i += 1;
    }
    counts
}
/// Takes each term of `xs` out of the multiset of `ys`. First: whether a
/// term of `xs` is not in `ys` at all. Second: whether nothing of `ys` is
/// left, that is, `ys` is included in `xs` as a multiset.
pub(crate) fn multiset_inclusion(xs: &[Term], ys: &[Term]) -> (bool, bool) {
    let mut counts = multiset(ys);
    let mut foreign = false;
    let mut i = 0;
    while i < xs.len() {
        match counts.entry(xs[i]) {
            Some(place) => counts.remove_one(place),
            None => foreign = true,
        }
        i += 1;
    }
    (foreign, counts.all_zero())
}
/// The terms of `xs` that pair off with a term of `ys` (`paired`), each
/// term of `ys` pairing once, or those that do not.
pub(crate) fn multiset_select(xs: &[Term], ys: &[Term], paired: bool) -> Vec<Term> {
    let mut counts = multiset(ys);
    let mut out = Vec::new();
    let mut i = 0;
    while i < xs.len() {
        let found = match counts.entry(xs[i]) {
            Some(place) => {
                let left = counts.count(place) > 0;
                counts.remove_one(place);
                left
            }
            None => false,
        };
        if found == paired {
            out.push(xs[i]);
        }
        i += 1;
    }
    out
}

#[cfg(test)]
mod cache_tests {
    use super::*;

    #[test]
    fn the_table_of_terms_finds_every_term_again_after_growing() {
        let mut s = Store::default();
        let slots = s.slots.len();
        let mut terms = Vec::new();
        for n in 0..5000u32 {
            let literal = s.numeral(Integer::from(n)).unwrap();
            let raw = s.raw(Lit::Numeral(Integer::from(n))).unwrap();
            let app = s.apply(literal, raw).unwrap();
            terms.push((literal, raw, app));
        }
        assert!(s.slots.len() > slots);
        assert!(s.slots.len() >= 2 * s.nodes.len());
        assert_eq!(s.nodes.len(), s.hashes.len());
        let nodes = s.nodes.len();
        for (n, &(literal, raw, app)) in terms.iter().enumerate() {
            let n = n as u32;
            assert_eq!(s.numeral(Integer::from(n)), Ok(literal));
            assert_eq!(s.raw(Lit::Numeral(Integer::from(n))), Ok(raw));
            assert_eq!(s.apply(literal, raw), Ok(app));
            assert_ne!(literal, raw);
        }
        assert_eq!(s.nodes.len(), nodes);
        // every handle is in exactly one slot
        let mut seen = vec![false; nodes];
        for &slot in &s.slots {
            if slot != 0 {
                assert!(!seen[(slot - 1) as usize]);
                seen[(slot - 1) as usize] = true;
            }
        }
        assert!(seen.iter().all(|&b| b));
    }

    #[test]
    fn invalid_cached_call_restores_depth_and_never_caches_an_error() {
        let mut s = Store::default();
        assert_eq!(
            generated::@$eo_typeof@(&mut s, Term(u32::MAX)),
            Err(CheckError::InvalidHandle)
        );
        assert_eq!(s.depth, 0);
        assert_eq!(s.cache_stats().type_entries, 0);
        let stuck = s.stuck();
        assert_eq!(generated::@$eo_typeof@(&mut s, stuck), Ok(stuck));
        let hits = s.cache_stats().type_hits;
        assert_eq!(generated::@$eo_typeof@(&mut s, stuck), Ok(stuck));
        assert_eq!(s.cache_stats().type_hits, hits + 1);
        assert_eq!(s.depth, 0);
    }
}
