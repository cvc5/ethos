;; The natives of the embedding: what a signature written in it may call that no
;; compiler writes.
;;
;; One entry is one native. It says what the native is called, what each of its
;; arguments is, and the operator it forwards to where that is not its own name.
;; That is the whole of what the declaration the desugar layer carries says, and
;; the compiler writes that declaration from here, so nothing states it twice;
;; see render_natives in tools/eoc/sem_compile.py and the
;; `(include "native_defs.eo")` of native_embed.eo, which is where what this
;; compiles to stands.
;;
;; What a native *does* is not said here. A backend says that in a native layer
;; of its own -- plugins/lean_meta/lean.eos and plugins/smt_meta/smt-vc.eos --
;; and the two are apart because neither implies the other: a backend may define
;; something the embedding never calls, and the embedding may call something a
;; backend gets from its own language.
;;
;; The type of an argument is named the way a type is named everywhere in the
;; configuration, i.e. a native in quotes.
;;
;; A native is named in the case a name of the target languages is written in,
;; i.e. lowercase, and alphanumeric but for the underscore. That is so the name
;; declared here can be the name it forwards to as well, which is what :op says
;; where it cannot be, and what is left out where it can -- as it is for all but
;; nine of them. That is also the name a backend implements it under, so an
;; entry of plugins/lean_meta/lean.eos or plugins/smt_meta/smt-vc.eos is named
;; after this one; a native neither layer implements is one both backends have
;; of their own.
;;
;; Two kinds of native cannot be named after what they forward to, and those are
;; what :op is for:
;;
;;   - one that forwards to a *literal* rather than to a function, as z_zero
;;     forwards to 0. That is what lets a whole number written in a body stand
;;     for a name of the embedding, see read_spelling in tools/eoc/sem_lang.py,
;;     and a literal is no name to declare one under;
;;   - one that forwards to something the target language already has, as
;;     n_succ forwards to nat.succ, whose name is not ours to choose and is no
;;     name here either, the dot being no part of one.

(declare-native true ())

(declare-native false ())

(declare-native z_zero () :op "0")

(declare-native z_one () :op "1")

(declare-native z_two () :op "2")

; strings
(declare-native z_max_code () :op "196608")

(declare-native z_max_width () :op "4294967296")

(declare-native streq ((x1 "String") (x2 "String")))

(declare-native not ((b "Bool")))

(declare-native and ((b1 "Bool") (b2 "Bool")))

(declare-native or ((b1 "Bool") (b2 "Bool")))

(declare-native iff ((b1 "Bool") (b2 "Bool")))

; Integer operators
; These assume zeq, zleq, zlt, zplus, zmult, zneg are defined as =, <=, <, +, *, -
(declare-native zeq ((x1 "Int") (x2 "Int")))

(declare-native zleq ((x1 "Int") (x2 "Int")))

(declare-native zlt ((x1 "Int") (x2 "Int")))

(declare-native zplus ((x1 "Int") (x2 "Int")))

(declare-native zmult ((x1 "Int") (x2 "Int")))

(declare-native zabs ((x1 "Int")))

; Real operators
; These assume qleq, qlt, qplus, qmult, qneg are defined as <=, <, +, *, -
(declare-native qeq ((x1 "Real") (x2 "Real")))

(declare-native qleq ((x1 "Real") (x2 "Real")))

(declare-native qlt ((x1 "Real") (x2 "Real")))

(declare-native qplus ((x1 "Real") (x2 "Real")))

(declare-native qmult ((x1 "Real") (x2 "Real")))

(declare-native qneg ((x1 "Real")))

(declare-native qabs ((x1 "Real")))

; other arithmetic
(declare-native to_real ((x1 "Int")))

(declare-native mk_rational ((x1 "Int") (x2 "Int")))

(declare-native qdiv_total ((x1 "Real") (x2 "Real")))

(declare-native div_total ((x1 "Int") (x2 "Int")))

(declare-native mod_total ((x1 "Int") (x2 "Int")))

(declare-native zexp_total ((x1 "Int") (x2 "Int")))

(declare-native qexp_total ((x1 "Real") (x2 "Int")))

; The (rounded-down) integer logarithm of x2 in base x1. This is the inverse of
; $native_z_**_total: it returns the greatest m>=0 such that x1^m <= x2, and 0
; when x1 <= 1 or x2 <= 0.
(declare-native int_log ((x1 "Int") (x2 "Int")))

(declare-native n_zero () :op "nat.zero")

(declare-native n_succ ((x1 "Nat")) :op "nat.succ")

(declare-native nateq ((x1 "Nat") (x2 "Nat")))

(declare-native z_to_n ((x1 "Int")) :op "int.to_nat")

(declare-native n_to_z ((x1 "Nat")) :op "nat.to_int")

; uconst utility
(declare-native uconst_id ((x1 "Nat")))

; abstract constant utility, note this namespace is distinct from the one used
; by $native_to_uconst_id, so that an abstract constant is never identified
; with an uninterpreted constant of the input problem.
(declare-native const_id ((x1 "Nat")))

; Whether s begins with the string p.
(declare-native string_prefix_eq ((p "String") (s "String")))

; define: $native_bit
; return: >
;   true iff the i^th bit of a binary with integer value x is set. Note this
;   method is agnostic to bitwidth.
(declare-native bit ((x "Int") (i "Int")))

; define: $native_msb
; return: >
;   true iff the most significant bit of the binary of width w and value n is
;   set.
(declare-native msb ((w "Int") (n "Int")))

; define: $native_binary_and
; return: >
;   The integer value of the binary value obtained by taking the bitwise and of
;   binary literals ($eo_binary w n1) and ($eo_binary w n2). This value will be
;   taken modulo 2^w.
; note: >
;   Assumes that 0 <= n1 < 2^w, 0 <= n2 < 2^w, 0 <= w.
(declare-native binary_and ((w "Int") (n1 "Int") (n2 "Int")))

; define: $native_binary_or
; return: >
;   The integer value of the binary value obtained by taking the bitwise or of
;   binary literals ($eo_binary w n1) and ($eo_binary w n2). This is equal to
;   n1+n2-($native_binary_and w n1 n2). This value will be taken modulo 2^w.
; note: >
;   Assumes that 0 <= n1 < 2^w, 0 <= n2 < 2^w, 0 <= w.
(declare-native binary_or ((w "Int") (n1 "Int") (n2 "Int")))

; define: $native_binary_xor
; return: >
;   The integer value of the binary value obtained by taking the bitwise xor of
;   binary literals ($eo_binary w n1) and ($eo_binary w n2). This is equal to
;   n1+n2-(2*($native_binary_and w n1 n2)). This value will be taken modulo 2^w.
; note: >
;   Assumes that 0 <= n1 < 2^w, 0 <= n2 < 2^w, 0 <= w.
(declare-native binary_xor ((w "Int") (n1 "Int") (n2 "Int")))

; define: $native_binary_not
; return: >
;   The integer value of the binary value obtained by taking bitwise not of
;   the binary literal ($eo_binary w n). This is equal to 2^w-(1+n). This value
;   will be taken modulo 2^w.
; note: >
;   Assumes that 0 <= n < 2^w, 0 <= w.
(declare-native binary_not ((w "Int") (n "Int")))

; define: $native_binary_max
; return: >
;   The integer value of the maximum unsigned binary value of width w. This is
;   equal to 2^w-1.
(declare-native binary_max ((w "Int")))

; define: $native_binary_uts
; return: >
;   The conversion of n from unsigned to signed integer, which is
;   2*(n mod 2^w-1) - n.
(declare-native binary_uts ((w "Int") (n "Int")))

; define: $native_binary_concat
; return: >
;   The integer value of the binary value obtained by concatenating binary
;   literals ($eo_binary w1 n1) and ($eo_binary w2 n2). This is equal to
;   n1*2^w2 + n2. Note the return value does not depend on w1. This value will
;   be taken modulo 2^(w1+w2).
; note: >
;   Assumes that 0 <= n1 < 2^w1, 0 <= n2 < 2^w2, 0 <= w1, 0 <= w2.
(declare-native binary_concat ((w1 "Int") (n1 "Int") (w2 "Int") (n2 "Int")))

; define: $native_binary_extract
; return: >
;   The integer value of the binary value obtained by extracting bits x1
;   through x2 (inclusive) of binary literal ($eo_binary w n). This is equal
;   to (div n 2^x1). This value will be taken modulo 2^(1+x2-x1).
; note: >
;   Assumes that 0 <= n < 2^w, 0 <= x1 <= x2 < w.
(declare-native binary_extract ((w "Int") (n "Int") (x1 "Int") (x2 "Int")))
