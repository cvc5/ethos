;; The natives of the embedding: what a signature written in it may call that no
;; compiler writes.
;;
;; One entry is one native. It says what the native is called, what each of its
;; arguments is, and the operator it forwards to where that is not its own name.
;; That is the whole of what the declaration the desugar layer carries says, and
;; the compiler writes that declaration from here, so nothing states it twice;
;; see render_natives in tools/eoc/sem_compile.py and the
;; `(include "native_defs.eo")` of native_embed.eo, which is where what this
;; compiles to stands.
;;
;; What a native that forwards to an operator *does* is not said here. A backend
;; says that in a native layer of its own -- plugins/lean_meta/lean.eos and
;; plugins/smt_meta/smt-vc.eos -- and the two are apart because neither implies
;; the other: a backend may define something the embedding never calls, and the
;; embedding may call something a backend gets from its own language.
;;
;; A native that forwards to nothing says what it *is* instead, under :is,
;; written in the vocabulary every body of a configuration is written in: a
;; native in quotes and everything else as itself, which there is a parameter.
;; No backend implements one, since what it is has been said once already. They
;; stand at the end, after the natives they are written over.
;;
;; The type of an argument is named the way a type is named everywhere in the
;; configuration, i.e. in quotes, and the types themselves are declared at the
;; head of this file. A bare name is a type variable instead, which only a
;; native the backends implement polymorphically may say.
;;
;; A native is named in the case a name of the target languages is written in,
;; i.e. lowercase, and alphanumeric but for the underscore. That is so the name
;; declared here can be the name it forwards to as well, which is what :op says
;; where it cannot be, and what is left out where it can -- as it is for all but
;; nine of them. That is also the name a backend implements it under, so an
;; entry of plugins/lean_meta/lean.eos or plugins/smt_meta/smt-vc.eos is named
;; after this one; a native neither layer implements is one both backends have
;; of their own. It comes out under a different spelling in each place it
;; reaches; the table is under "What one native is called" in
;; tools/eoc/README.md.
;;
;; Two kinds of native cannot be named after what they forward to, and those are
;; what :op is for:
;;
;;   - one that forwards to a *literal* rather than to a function, as z_zero
;;     forwards to 0. That is what lets a whole number written in a body stand
;;     for a name of the embedding, see read_spelling in tools/eoc/sem_lang.py,
;;     and a literal is no name to declare one under;
;;   - one that forwards to something the target language already has, as
;;     n_succ forwards to nat.succ, whose name is not ours to choose and is no
;;     name here either, the dot being no part of one.

; The primitive types of the embedding. The name is the embedding's own and
; the backend's is what :op says, the way it says the operator a native
; forwards to: what a backend implements is `Int`, and what everything on this
; side calls it is `<numeral>`. They are apart because neither follows the
; other. Three of these name no SMT-LIB sort -- `<nat>` is a datatype a backend
; declares, `<char>` and `<rational>` are sorts it defines for itself -- and
; `Int` names one that is not what the embedding means by it, since a width and
; an identifier are of it as much as a numeral is.

(declare-native-type <bool> :op "Bool")

(declare-native-type <numeral> :op "Int")

(declare-native-type <rational> :op "Rat")

(declare-native-type <string> :op "String")

(declare-native-type <char> :op "Char")

; A natural number, which is a datatype of the embedding rather than a sort a
; backend has of its own.
(declare-native-type <nat> :op "Nat" :datatype)

(declare-native true ())

(declare-native false ())

(declare-native z_zero () :op "0")

(declare-native z_one () :op "1")

(declare-native z_two () :op "2")

; strings
(declare-native z_max_code () :op "196608")

(declare-native z_max_width () :op "4294967296")

(declare-native streq ((x1 <string>) (x2 <string>)))

; The string constants the embedding is written over. Each forwards to a
; string literal rather than to a function, which is what :op says here as it
; does for a native that forwards to a numeral: a set escapes a quote with a
; backslash and Eunoia by doubling it, so what stands here is the former and
; what is written out is the latter. See escape_eo in tools/eoc/sem_compile.py.
(declare-native str_c0 () :op "\"0\"")

(declare-native str_c9 () :op "\"9\"")

; What a signature that reserves names by a prefix reserves them with, and the
; names CPC builds with it. What they mean is no business of the embedding; a
; signature says that for itself, see $eo_to_smt_reserved_datatype_name in
; tools/eoc/semantics/development-cpc.eos.
(declare-native str_at_sign () :op "\"@\"")

(declare-native str_vname () :op "\"@x\"")

(declare-native str_tuple_name () :op "\"@Tuple\"")

; The one native that is of every type at once, and so the one whose arguments
; name a type variable rather than a type. Both backends implement it that
; way, see native_ite in plugins/lean_meta/lean.eos.
(declare-native ite ((b <bool>) (x1 W) (x2 W)))

(declare-native not ((b <bool>)))

(declare-native and ((b1 <bool>) (b2 <bool>)))

(declare-native or ((b1 <bool>) (b2 <bool>)))

(declare-native iff ((b1 <bool>) (b2 <bool>)))

; Integer operators
; These assume zeq, zleq, zlt, zplus, zmult, zneg are defined as =, <=, <, +, *, -
(declare-native zeq ((x1 <numeral>) (x2 <numeral>)))

(declare-native zleq ((x1 <numeral>) (x2 <numeral>)))

(declare-native zlt ((x1 <numeral>) (x2 <numeral>)))

(declare-native zplus ((x1 <numeral>) (x2 <numeral>)))

(declare-native zmult ((x1 <numeral>) (x2 <numeral>)))

(declare-native zneg ((x1 <numeral>)))

(declare-native zabs ((x1 <numeral>)))

; Real operators
; These assume qleq, qlt, qplus, qmult, qneg are defined as <=, <, +, *, -
(declare-native qeq ((x1 <rational>) (x2 <rational>)))

(declare-native qleq ((x1 <rational>) (x2 <rational>)))

(declare-native qlt ((x1 <rational>) (x2 <rational>)))

(declare-native qplus ((x1 <rational>) (x2 <rational>)))

(declare-native qmult ((x1 <rational>) (x2 <rational>)))

(declare-native qneg ((x1 <rational>)))

(declare-native qabs ((x1 <rational>)))

; other arithmetic
(declare-native to_real ((x1 <numeral>)))

(declare-native mk_rational ((x1 <numeral>) (x2 <numeral>)))

(declare-native qdiv_total ((x1 <rational>) (x2 <rational>)))

(declare-native div_total ((x1 <numeral>) (x2 <numeral>)))

(declare-native mod_total ((x1 <numeral>) (x2 <numeral>)))

(declare-native zexp_total ((x1 <numeral>) (x2 <numeral>)))

(declare-native qexp_total ((x1 <rational>) (x2 <numeral>)))

; The (rounded-down) integer logarithm of x2 in base x1. This is the inverse of
; $native_z_**_total: it returns the greatest m>=0 such that x1^m <= x2, and 0
; when x1 <= 1 or x2 <= 0.
(declare-native int_log ((x1 <numeral>) (x2 <numeral>)))

; Two to the power of x1, which the width arithmetic of the binary literal
; type is written over.
(declare-native z_pow2 ((x1 <numeral>)) :op "int.pow2")

(declare-native n_zero () :op "nat.zero")

(declare-native n_succ ((x1 <nat>)) :op "nat.succ")

(declare-native nateq ((x1 <nat>) (x2 <nat>)))

(declare-native z_to_n ((x1 <numeral>)) :op "int.to_nat")

(declare-native n_to_z ((x1 <nat>)) :op "nat.to_int")

; uconst utility
(declare-native uconst_id ((x1 <nat>)))

; abstract constant utility, note this namespace is distinct from the one used
; by $native_to_uconst_id, so that an abstract constant is never identified
; with an uninterpreted constant of the input problem.
(declare-native const_id ((x1 <nat>)))

; Whether s begins with the string p.
(declare-native string_prefix_eq ((p <string>) (s <string>)))

; define: $native_bit
; return: >
;   true iff the i^th bit of a binary with integer value x is set. Note this
;   method is agnostic to bitwidth.
(declare-native bit ((x <numeral>) (i <numeral>)))

; define: $native_msb
; return: >
;   true iff the most significant bit of the binary of width w and value n is
;   set.
(declare-native msb ((w <numeral>) (n <numeral>)))

; define: $native_binary_and
; return: >
;   The integer value of the binary value obtained by taking the bitwise and of
;   binary literals ($eo_binary w n1) and ($eo_binary w n2). This value will be
;   taken modulo 2^w.
; note: >
;   Assumes that 0 <= n1 < 2^w, 0 <= n2 < 2^w, 0 <= w.
(declare-native binary_and ((w <numeral>) (n1 <numeral>) (n2 <numeral>)))

; define: $native_binary_or
; return: >
;   The integer value of the binary value obtained by taking the bitwise or of
;   binary literals ($eo_binary w n1) and ($eo_binary w n2). This is equal to
;   n1+n2-($native_binary_and w n1 n2). This value will be taken modulo 2^w.
; note: >
;   Assumes that 0 <= n1 < 2^w, 0 <= n2 < 2^w, 0 <= w.
(declare-native binary_or ((w <numeral>) (n1 <numeral>) (n2 <numeral>)))

; define: $native_binary_xor
; return: >
;   The integer value of the binary value obtained by taking the bitwise xor of
;   binary literals ($eo_binary w n1) and ($eo_binary w n2). This is equal to
;   n1+n2-(2*($native_binary_and w n1 n2)). This value will be taken modulo 2^w.
; note: >
;   Assumes that 0 <= n1 < 2^w, 0 <= n2 < 2^w, 0 <= w.
(declare-native binary_xor ((w <numeral>) (n1 <numeral>) (n2 <numeral>)))

; define: $native_binary_not
; return: >
;   The integer value of the binary value obtained by taking bitwise not of
;   the binary literal ($eo_binary w n). This is equal to 2^w-(1+n). This value
;   will be taken modulo 2^w.
; note: >
;   Assumes that 0 <= n < 2^w, 0 <= w.
(declare-native binary_not ((w <numeral>) (n <numeral>)))

; define: $native_binary_max
; return: >
;   The integer value of the maximum unsigned binary value of width w. This is
;   equal to 2^w-1.
(declare-native binary_max ((w <numeral>)))

; define: $native_binary_uts
; return: >
;   The conversion of n from unsigned to signed integer, which is
;   2*(n mod 2^w-1) - n.
(declare-native binary_uts ((w <numeral>) (n <numeral>)))

; define: $native_binary_concat
; return: >
;   The integer value of the binary value obtained by concatenating binary
;   literals ($eo_binary w1 n1) and ($eo_binary w2 n2). This is equal to
;   n1*2^w2 + n2. Note the return value does not depend on w1. This value will
;   be taken modulo 2^(w1+w2).
; note: >
;   Assumes that 0 <= n1 < 2^w1, 0 <= n2 < 2^w2, 0 <= w1, 0 <= w2.
(declare-native binary_concat ((w1 <numeral>) (n1 <numeral>) (w2 <numeral>) (n2 <numeral>)))

; define: $native_binary_extract
; return: >
;   The integer value of the binary value obtained by extracting bits x1
;   through x2 (inclusive) of binary literal ($eo_binary w n). This is equal
;   to (div n 2^x1). This value will be taken modulo 2^(1+x2-x1).
; note: >
;   Assumes that 0 <= n < 2^w, 0 <= x1 <= x2 < w.
(declare-native binary_extract ((w <numeral>) (n <numeral>) (x1 <numeral>) (x2 <numeral>)))

; ---------------------------------------------------------------------------
; The natives written over the others

; What a native is where it forwards to nothing is what :is says, written in
; the vocabulary every body of a configuration is written in: a native in
; quotes and everything else as itself, which here is a parameter. A backend
; implements none of these -- what they are is said once, here -- so they are
; the ones a backend's layer is silent about.

(declare-native z_neg_one () :is ("zneg" "z_one"))

(declare-native z_- ((x1 <numeral>) (x2 <numeral>))
  :is ("zplus" x1 ("zneg" x2)))

(declare-native z_inc ((x1 <numeral>)) :is ("zplus" x1 "z_one"))

(declare-native z_dec ((x1 <numeral>)) :is ("zplus" x1 "z_neg_one"))

(declare-native q_- ((x1 <rational>) (x2 <rational>))
  :is ("qplus" x1 ("qneg" x2)))

(declare-native q_zero () :is ("mk_rational" "z_zero" "z_one"))

; A natural number is what a character is written as, so this is what says
; which of the two a place means rather than what it converts.
(declare-native n_to_char ((n <nat>)) :is n)

