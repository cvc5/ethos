        ($sm_DtSel $native_str_tuple_name ($eo_to_smt_tuple_decl d) $native_n_zero ($native_z_to_n n))
        t)
      $sm_none))
  (($eo_to_smt_tuple_select T n t)                    $sm_none)
  )
)

