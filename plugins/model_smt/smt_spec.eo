; Fixed Eunoia specification of SMT-LIB model semantics.
; 
; This file is consumed by the model-smt plugin. It is partitioned into
; per-operator blocks by ;;!op / ;;!section / ;;!endop directives; each
; section is spliced verbatim at the corresponding $<MARKER>$ of
; model_smt.eo when the operator is selected. An operator is selected when
; the user signature declares its name (or the overload named by :alias);
; blocks referenced from the text of selected blocks are included
; transitively with their smt-layer sections only. See model_smt.h.
; 
; This file was bootstrapped by harvesting the former C++ operator tables
; (EOC_MODEL_SMT_HARVEST); it is now the source of truth for the semantics.

;;!op =
;;!section EO_TO_SMT_CASES
  (($eo_to_smt (= x1 x2)) ($sm_= ($eo_to_smt x1) ($eo_to_smt x2)))
;;!endop
;;!op ite
;;!section EO_TO_SMT_CASES
  (($eo_to_smt (ite x1 x2 x3)) ($sm_ite ($eo_to_smt x1) ($eo_to_smt x2) ($eo_to_smt x3)))
;;!endop
;;!op distinct
;;!section EO_TO_SMT_CASES
  (($eo_to_smt (distinct x1)) ($native_ite ($native_Teq ($eo_to_smt_typed_list_elem_type x1) $tsm_none) $sm_none ($eo_to_smt_distinct x1)))
;;!section EO_TO_SMT_AUX

(program $eo_to_smt_distinct_pairs
  ((T Type) (s $smt_Term) (x T) (xs (@@TypedList T)))
  :signature ($smt_Term (@@TypedList T)) $smt_Term
  (
  (($eo_to_smt_distinct_pairs s (@@TypedList.cons x xs))
     ($sm_and ($sm_not ($sm_= s ($eo_to_smt x))) ($eo_to_smt_distinct_pairs s xs)))
  (($eo_to_smt_distinct_pairs s (@@TypedList.nil T)) $sm_true)
  (($eo_to_smt_distinct_pairs s xs) $sm_none)
  )
)
(program $eo_to_smt_distinct
  ((T Type) (s $smt_Term) (x T) (xs (@@TypedList T)))
  :signature ((@@TypedList T)) $smt_Term
  (
  (($eo_to_smt_distinct (@@TypedList.cons x xs))
     ($sm_and ($eo_to_smt_distinct_pairs ($eo_to_smt x) xs) ($eo_to_smt_distinct xs)))
  (($eo_to_smt_distinct (@@TypedList.nil T)) $sm_true)
  (($eo_to_smt_distinct xs) $sm_none)
  )
)
(program $eo_to_smt_typed_list_elem_type ((T Type) (t T) (ts (@@TypedList T)))
  :signature (T) $smt_Type
  (
  (($eo_to_smt_typed_list_elem_type (@@TypedList.nil T))
    (eo::define ((eT ($eo_to_smt_type T)))
      ($native_ite ($smtx_type_wf eT) eT $tsm_none)))
  (($eo_to_smt_typed_list_elem_type (@@TypedList.cons t ts))
    (eo::define ((eT ($smtx_typeof ($eo_to_smt t))))
      ($native_ite ($native_Teq eT ($eo_to_smt_typed_list_elem_type ts))
        eT
        $tsm_none)))    
  (($eo_to_smt_typed_list_elem_type t) $tsm_none)
  )
)

;;!endop
;;!op @@TypedList.cons
;;!section EO_DESUGAR_AUX

(program $eo_is_list_nil_@@TypedList.cons ((T Type)) 
  :signature (T) Bool
  (
  (($eo_is_list_nil_@@TypedList.cons (@@TypedList.nil T)) true)
  )
)
;;!endop
;;!op and
;;!section SMT_TERM_CONSTRUCTORS
(declare-parameterized-const $emb_sm.and ((x1 $smt_Term :opaque) (x2 $smt_Term :opaque)) $smt_Term)
(define $sm_and ((x1 $smt_Term) (x2 $smt_Term)) ($emb_sm.and x1 x2))
;;!section SMT_TYPEOF_CASES
  (($smtx_typeof ($sm_and x1 x2)) ($native_ite ($native_Teq ($smtx_typeof x1) $tsm_Bool) ($native_ite ($native_Teq ($smtx_typeof x2) $tsm_Bool) $tsm_Bool $tsm_none) $tsm_none))
;;!section SMT_EVAL_CASES
  (($smtx_model_eval M ($sm_and x1 x2)) ($smtx_model_eval_and ($smtx_model_eval M x1) ($smtx_model_eval M x2)))
;;!section SMT_EVAL_PROGS_FWD_DECL
(program $smtx_model_eval_and () :signature ($smt_Value $smt_Value) $smt_Value)
;;!section SMT_EVAL_PROGS
(program $smtx_model_eval_and
  ((x1 $native_Bool)(x2 $native_Bool) (t1 $smt_Value) (t2 $smt_Value))
  :signature ($smt_Value $smt_Value) $smt_Value
  (
  (($smtx_model_eval_and ($vsm_bool x1) ($vsm_bool x2)) ($vsm_bool ($native_apply_2 "and" x1 x2)))
  (($smtx_model_eval_and t1 t2) $vsm_not_value)
  )
)
;;!section EO_TO_SMT_CASES
  (($eo_to_smt (and x1 x2)) ($sm_and ($eo_to_smt x1) ($eo_to_smt x2)))
;;!endop
;;!op or
;;!section SMT_TERM_CONSTRUCTORS
(declare-parameterized-const $emb_sm.or ((x1 $smt_Term :opaque) (x2 $smt_Term :opaque)) $smt_Term)
(define $sm_or ((x1 $smt_Term) (x2 $smt_Term)) ($emb_sm.or x1 x2))
;;!section SMT_TYPEOF_CASES
  (($smtx_typeof ($sm_or x1 x2)) ($native_ite ($native_Teq ($smtx_typeof x1) $tsm_Bool) ($native_ite ($native_Teq ($smtx_typeof x2) $tsm_Bool) $tsm_Bool $tsm_none) $tsm_none))
;;!section SMT_EVAL_CASES
  (($smtx_model_eval M ($sm_or x1 x2)) ($smtx_model_eval_or ($smtx_model_eval M x1) ($smtx_model_eval M x2)))
;;!section SMT_EVAL_PROGS_FWD_DECL
(program $smtx_model_eval_or () :signature ($smt_Value $smt_Value) $smt_Value)
;;!section SMT_EVAL_PROGS
(program $smtx_model_eval_or
  ((x1 $native_Bool)(x2 $native_Bool) (t1 $smt_Value) (t2 $smt_Value))
  :signature ($smt_Value $smt_Value) $smt_Value
  (
  (($smtx_model_eval_or ($vsm_bool x1) ($vsm_bool x2)) ($vsm_bool ($native_apply_2 "or" x1 x2)))
  (($smtx_model_eval_or t1 t2) $vsm_not_value)
  )
)
;;!section EO_TO_SMT_CASES
  (($eo_to_smt (or x1 x2)) ($sm_or ($eo_to_smt x1) ($eo_to_smt x2)))
;;!endop
;;!op xor
;;!section SMT_TERM_CONSTRUCTORS
(declare-parameterized-const $emb_sm.xor ((x1 $smt_Term :opaque) (x2 $smt_Term :opaque)) $smt_Term)
(define $sm_xor ((x1 $smt_Term) (x2 $smt_Term)) ($emb_sm.xor x1 x2))
;;!section SMT_TYPEOF_CASES
  (($smtx_typeof ($sm_xor x1 x2)) ($native_ite ($native_Teq ($smtx_typeof x1) $tsm_Bool) ($native_ite ($native_Teq ($smtx_typeof x2) $tsm_Bool) $tsm_Bool $tsm_none) $tsm_none))
;;!section SMT_EVAL_CASES
  (($smtx_model_eval M ($sm_xor x1 x2)) ($smtx_model_eval_xor ($smtx_model_eval M x1) ($smtx_model_eval M x2)))
;;!section SMT_EVAL_PROGS_FWD_DECL
(program $smtx_model_eval_xor () :signature ($smt_Value $smt_Value) $smt_Value)
;;!section SMT_EVAL_PROGS
(program $smtx_model_eval_xor
  ((x1 $smt_Value)(x2 $smt_Value))
  :signature ($smt_Value $smt_Value) $smt_Value
  (
  (($smtx_model_eval_xor x1 x2) ($smtx_model_eval_not ($smtx_model_eval_= x1 x2)))
  )
)
;;!section EO_TO_SMT_CASES
  (($eo_to_smt (xor x1 x2)) ($sm_xor ($eo_to_smt x1) ($eo_to_smt x2)))
;;!endop
;;!op =>
;;!section SMT_TERM_CONSTRUCTORS
(declare-parameterized-const $emb_sm.=> ((x1 $smt_Term :opaque) (x2 $smt_Term :opaque)) $smt_Term)
(define $sm_=> ((x1 $smt_Term) (x2 $smt_Term)) ($emb_sm.=> x1 x2))
;;!section SMT_TYPEOF_CASES
  (($smtx_typeof ($sm_=> x1 x2)) ($native_ite ($native_Teq ($smtx_typeof x1) $tsm_Bool) ($native_ite ($native_Teq ($smtx_typeof x2) $tsm_Bool) $tsm_Bool $tsm_none) $tsm_none))
;;!section SMT_EVAL_CASES
  (($smtx_model_eval M ($sm_=> x1 x2)) ($smtx_model_eval_=> ($smtx_model_eval M x1) ($smtx_model_eval M x2)))
;;!section SMT_EVAL_PROGS_FWD_DECL
(program $smtx_model_eval_=> () :signature ($smt_Value $smt_Value) $smt_Value)
;;!section SMT_EVAL_PROGS
(program $smtx_model_eval_=>
  ((x1 $smt_Value)(x2 $smt_Value))
  :signature ($smt_Value $smt_Value) $smt_Value
  (
  (($smtx_model_eval_=> x1 x2) ($smtx_model_eval_or ($smtx_model_eval_not x1) x2))
  )
)
;;!section EO_TO_SMT_CASES
  (($eo_to_smt (=> x1 x2)) ($sm_=> ($eo_to_smt x1) ($eo_to_smt x2)))
;;!endop
;;!op not
;;!section SMT_TERM_CONSTRUCTORS
(declare-parameterized-const $emb_sm.not ((x1 $smt_Term :opaque)) $smt_Term)
(define $sm_not ((x1 $smt_Term)) ($emb_sm.not x1))
;;!section SMT_TYPEOF_CASES
  (($smtx_typeof ($sm_not x1)) ($native_ite ($native_Teq ($smtx_typeof x1) $tsm_Bool) $tsm_Bool $tsm_none))
;;!section SMT_EVAL_CASES
  (($smtx_model_eval M ($sm_not x1)) ($smtx_model_eval_not ($smtx_model_eval M x1)))
;;!section SMT_EVAL_PROGS_FWD_DECL
(program $smtx_model_eval_not () :signature ($smt_Value) $smt_Value)
;;!section SMT_EVAL_PROGS
(program $smtx_model_eval_not
  ((x1 $native_Bool) (t1 $smt_Value))
  :signature ($smt_Value) $smt_Value
  (
  (($smtx_model_eval_not ($vsm_bool x1)) ($vsm_bool ($native_apply_1 "not" x1)))
  (($smtx_model_eval_not t1) $vsm_not_value)
  )
)
;;!section EO_TO_SMT_CASES
  (($eo_to_smt (not x1)) ($sm_not ($eo_to_smt x1)))
;;!endop
;;!op Int
;;!section EO_TO_SMT_TYPE_CASES
  (($eo_to_smt_type Int) $tsm_Int)
;;!endop
;;!op Real
;;!section EO_TO_SMT_TYPE_CASES
  (($eo_to_smt_type Real) $tsm_Real)
;;!endop
;;!op +
;;!section SMT_TERM_CONSTRUCTORS
(declare-parameterized-const $emb_sm.+ ((x1 $smt_Term :opaque) (x2 $smt_Term :opaque)) $smt_Term)
(define $sm_+ ((x1 $smt_Term) (x2 $smt_Term)) ($emb_sm.+ x1 x2))
;;!section SMT_TYPEOF_CASES
  (($smtx_typeof ($sm_+ x1 x2)) ($smtx_typeof_arith_overload_op_2 ($smtx_typeof x1) ($smtx_typeof x2)))
;;!section SMT_EVAL_CASES
  (($smtx_model_eval M ($sm_+ x1 x2)) ($smtx_model_eval_+ ($smtx_model_eval M x1) ($smtx_model_eval M x2)))
;;!section SMT_EVAL_PROGS_FWD_DECL
(program $smtx_model_eval_+ () :signature ($smt_Value $smt_Value) $smt_Value)
;;!section SMT_EVAL_PROGS
(program $smtx_model_eval_+
  ((x1 $native_Int)(x2 $native_Int) (x3 $native_Real) (x4 $native_Real) (t1 $smt_Value) (t2 $smt_Value))
  :signature ($smt_Value $smt_Value) $smt_Value
  (
  (($smtx_model_eval_+ ($vsm_numeral x1) ($vsm_numeral x2)) ($vsm_numeral ($native_z_+ x1 x2)))
  (($smtx_model_eval_+ ($vsm_rational x3) ($vsm_rational x4)) ($vsm_rational ($native_q_+ x3 x4)))
  (($smtx_model_eval_+ t1 t2) $vsm_not_value)
  )
)
;;!section EO_TO_SMT_CASES
  (($eo_to_smt (+ x1 x2)) ($sm_+ ($eo_to_smt x1) ($eo_to_smt x2)))
;;!section EO_DESUGAR_AUX
(program $eo_is_list_nil_+ ((T Type) (x1 T))
  :signature (T) Bool
  (
  (($eo_is_list_nil_+ x1) (eo::is_eq (eo::to_q x1) 0/1))
  )
)

;;!endop
;;!op -
