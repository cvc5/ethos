; The CPC signature, together with its Eunoia-to-SMT reductions.
;
; This file is the entry point of CPC for the ethos-eoc compiler: it includes
; the signature itself and then gives the reductions below, so that they are
; parsed along with it and carried through every stage. Point the compiler at
; this file rather than at Cpc.eo, see tools/eoc/README.md.
;
; The model_smt plugin turns a desugared Eunoia signature into the SMT-LIB
; model semantics of its symbols. Most symbols are given that semantics by the
; plugin itself, which knows how to evaluate an SMT-LIB operator of a given
; name and argument kinds. The symbols below are the exception: they are
; *eliminated* on the way from Eunoia to the SMT-LIB term layer, i.e. they are
; defined in terms of the other symbols of this signature.
;
; A reduction is a `define` whose name is $eo_reduce_ followed by the symbol it
; reduces, and whose parameters are that symbol's explicit arguments. Its body
; is an ordinary term of this signature: nothing here mentions $eo_to_smt, the
; $sm_ constructors of the deep embedding, or anything else of the generated
; model semantics. So, for example,
;
;   (define $eo_reduce_@mod_by_zero ((x Int)) (mod x 0))
;
; says that (@mod_by_zero x) denotes whatever (mod x 0) denotes. The plugin
; casts that term into the SMT-LIB term layer and generates the case
;
;   (($eo_to_smt (@mod_by_zero x1))
;     ($sm_mod ($eo_to_smt x1) ($sm_numeral ($native_apply_0 "0"))))
;
; of $eo_to_smt from it: an application of a symbol becomes an application of
; the constructor of the same name, a literal becomes the constructor of its
; kind applied to its native value, and a parameter, being a Eunoia term at the
; time the case runs, is cast by $eo_to_smt itself.
;
; Since a reduction is an ordinary command of the signature, one that names a
; symbol this signature does not declare is an error here rather than something
; that surfaces later in a generated file. For the same reason a reduction file
; belongs to one signature. Every stage before model_smt carries a reduction
; through: trim-defs treats it as a defining command of the symbol it reduces,
; so that trimming the signature to what one proof rule needs keeps the
; reductions of the symbols that survive together with everything their bodies
; name, and drops the rest; the desugar stage re-emits it in the desugared
; syntax. See getReduceDefPrefix in plugins/utils.h.
;
; A reduction is elaborated like any other term of this signature, so an
; application of an n-ary symbol carries its nil terminator: (and x y) denotes
; (and x (and y true)), and its embedding has the same shape. Write (_ and x y)
; where the reduction means the binary application itself, as int.ispow2 below
; does.
;
; A reduction is not type checked, since its embedding is structural. So one
; this signature cannot type, such as @bit's below, is used as it stands.
;
; The symbols whose reduction this file cannot express are registered by the
; plugin instead, see ModelSmt::addEunoiaReduceSym. Those are the ones whose
; right hand side has to bind a variable, recurse, inspect an SMT-LIB type,
; name an operator of the deep embedding that has no counterpart in this
; signature, or name a symbol that is itself eliminated.

(include "../../../cvc5-ajr/proofs/eo/cpc/Cpc.eo")

; -----------------------------------------------------------------------------
; Arithmetic
; -----------------------------------------------------------------------------

; The value of division, modulus and real division by zero. Note these denote
; the same thing as the corresponding operator applied to zero, which is what
; makes them underspecified rather than undefined.

(define $eo_reduce_@int_div_by_zero ((x Int)) (div x 0))
(define $eo_reduce_@mod_by_zero ((x Int)) (mod x 0))
(define $eo_reduce_@div_by_zero ((x Real)) (/ x 0/1))

; x is a power of two if it is non-negative and is recovered by taking the
; power of two of its base-two logarithm.

(define $eo_reduce_int.ispow2 ((x Int))
  (_ and (>= x 0) (= x (int.pow2 (int.log2 x)))))

; -----------------------------------------------------------------------------
; Bit-vectors
; -----------------------------------------------------------------------------

; The bit-vector conditional, whose condition is a one-bit vector rather than a
; Boolean.

(define $eo_reduce_bvite ((T Type :implicit) (c (BitVec 1)) (x T) (y T))
  (ite (= c #b1) x y))

; The bit-vector-valued comparisons, which denote the one-bit vector that the
; corresponding Boolean comparison sets.

(define $eo_reduce_bvultbv ((m Int :implicit) (x (BitVec m)) (y (BitVec m)))
  (ite (bvult x y) #b1 #b0))
(define $eo_reduce_bvsltbv ((m Int :implicit) (x (BitVec m)) (y (BitVec m)))
  (ite (bvslt x y) #b1 #b0))

; The i^th bit of x, which is set exactly when the one-bit extraction at i is
; one. Note this signature does not type the equality below, since it does not
; reduce the width of that extraction, (eo::add i (eo::neg i) 1), to 1.

(define $eo_reduce_@bit ((m Int :implicit) (i Int) (x (BitVec m)))
  (= (extract i i x) #b1))

; Prepending a Boolean to a bit-vector, as the bit it denotes.

(define $eo_reduce_@from_bools ((n Int :implicit) (b Bool) (x (BitVec n)))
  (_ concat x (ite b #b1 #b0)))

; -----------------------------------------------------------------------------
; Strings and sequences
; -----------------------------------------------------------------------------

; The result of converting an integer to a string, resp. a string to an
; integer, when the conversion fails at position n: the conversion of the
; prefix of length n, and zero when that prefix is empty.

(define $eo_reduce_@strings_itos_result ((x Int) (n Int))
  (ite (= n 0) 0 (str.to_int (str.substr (str.from_int x) 0 n))))
(define $eo_reduce_@strings_stoi_result ((s (Seq Char)) (n Int))
  (ite (= n 0) 0 (str.to_int (str.substr s 0 n))))

; The position of the first character of s that is not a digit.

(define $eo_reduce_@strings_stoi_non_digit ((s (Seq Char)))
  (str.indexof_re s (_ re.inter re.allchar (re.comp (re.range "0" "9"))) 0))

; The number of non-overlapping occurrences of t in s, resp. of nonempty,
; leftmost-shortest matches of the regular expression r in s. Both are the
; difference in length between replacing every occurrence by a sequence of
; length one and replacing it by the empty sequence. Note (str.substr s 0 1)
; and (str.substr s 0 0) are used for those two sequences, which avoids having
; to name the element type of s.

(define $eo_reduce_@strings_num_occur ((T Type :implicit) (s (Seq T)) (t (Seq T)))
  (- (str.len (str.replace_all s t (str.substr s 0 1)))
     (str.len (str.replace_all s t (str.substr s 0 0)))))
(define $eo_reduce_@strings_num_occur_re ((s (Seq Char)) (r RegLan))
  (- (str.len (str.replace_re_all s r (str.substr s 0 1)))
     (str.len (str.replace_re_all s r (str.substr s 0 0)))))

; The part of a replace-all that is left to do after the n^th occurrence, i.e.
; the replacement carried out on the suffix of s that follows that occurrence.

(define $eo_reduce_@strings_replace_all_result
    ((T Type :implicit) (s (Seq T)) (t (Seq T)) (r (Seq T)) (n Int))
  (str.replace_all
    (str.substr s (@strings_occur_index s t n) (str.len s)) t r))
(define $eo_reduce_@strings_replace_re_all_result
    ((s (Seq Char)) (r RegLan) (t (Seq Char)) (n Int))
  (str.replace_re_all
    (str.substr s (@strings_occur_index_re s r n) (str.len s)) r t))
