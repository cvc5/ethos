(declare-parameterized-const $emb_sm.@purify ((x1 $smt_Term :opaque)) $smt_Term)
(define $sm_@purify ((x1 $smt_Term)) ($emb_sm.@purify x1))
;;!section SMT_TYPEOF_CASES
