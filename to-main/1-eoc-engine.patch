+/******************************************************************************
+ * This file is part of the ethos project.
+ *
+ * Copyright (c) 2023-2024 by the authors listed in the file AUTHORS
+ * in the top-level source directory and their institutional affiliations.
+ * All rights reserved.  See the file COPYING in the top-level source
+ * directory for licensing information.
+ ******************************************************************************/
+#include "native_layer.h"
+
+#include <fstream>
+#include <sstream>
+
+#include "base/check.h"
+
+namespace ethos {
+
+NativeLayer::NativeLayer(const std::string& path,
+                         const std::string& comment,
+                         const std::string& top)
+    : d_top(top)
+{
+  std::ifstream in(path);
+  if (!in.is_open())
+  {
+    EO_FATAL() << "NativeLayer: could not read " << path;
+  }
+  const std::string opens = comment + " $native";
+  const std::string keeps = opens + "-keep ";
+  const std::string block = opens + " ";
+  std::vector<std::string> keep;
+  std::string line;
+  while (std::getline(in, line))
+  {
+    if (line.compare(0, opens.size(), opens) != 0)
+    {
+      // Everything under the line that opens a block is the block, its own
+      // comment included, up to the line that opens the next.
+      if (!d_defs.empty())
+      {
+        d_defs.back().d_text += line + "\n";
+      }
+      continue;
+    }
+    bool isKeep = line.compare(0, keeps.size(), keeps) == 0;
+    if (!isKeep && line.compare(0, block.size(), block) != 0)
+    {
+      EO_FATAL() << "NativeLayer: `" << line << "` is not a line " << path
+                 << " writes";
+    }
+    std::vector<std::string> ws;
+    std::stringstream ls(line.substr(isKeep ? keeps.size() : block.size()));
+    std::string w;
+    while (ls >> w)
+    {
+      ws.push_back(w);
+    }
+    if (isKeep)
+    {
+      keep = ws;
+      continue;
+    }
+    if (ws.size() < 2)
+    {
+      EO_FATAL() << "NativeLayer: a block says its name and the narrowest "
+                    "scope it can come out in, got `"
+                 << line << "`";
+    }
+    Def d;
+    d.d_name = ws[0];
+    d.d_needs = ws[1];
+    d.d_deps.assign(ws.begin() + 2, ws.end());
+    d_of[d.d_name] = d_defs.size();
+    d_defs.push_back(d);
+  }
+  if (d_defs.empty())
+  {
+    EO_FATAL() << "NativeLayer: " << path << " holds no block";
+  }
+  // What no input asks for, because the resources of the stage are what name
+  // it. They are written above every module that holds a block, so the scope
+  // they all see is where it comes out.
+  for (const std::string& n : keep)
+  {
+    use(n, d_top);
+  }
+}
+
+void NativeLayer::use(const std::string& n) { use(n, d_top); }
+
+void NativeLayer::use(const std::string& n, const std::string& scope)
+{
+  std::map<std::string, size_t>::const_iterator b = d_of.find(n);
+  if (b == d_of.end())
+  {
+    return;
+  }
+  const Def& d = d_defs[b->second];
+  std::string at = scope;
+  if (d.d_needs != d_top)
+  {
+    // One module can hold it, so nothing narrower is being asked for; a
+    // module that cannot see that one has named something it cannot reach.
+    if (scope != d.d_needs && scope != d_top)
+    {
+      EO_FATAL() << "NativeLayer: `" << n << "` comes out in " << d.d_needs
+                 << ", which the " << scope
+                 << " scope that names it cannot see";
+    }
+    at = d.d_needs;
+  }
+  std::pair<std::map<std::string, std::string>::iterator, bool> u =
+      d_at.emplace(n, at);
+  if (!u.second)
+  {
+    if (u.first->second == at)
+    {
+      return;
+    }
+    // Reached from two scopes, so it comes out in the one they share.
+    at = d_top;
+    if (u.first->second == at)
+    {
+      return;
+    }
+    u.first->second = at;
+  }
+  for (const std::string& dep : d.d_deps)
+  {
+    use(dep, at);
+  }
+}
+
+std::string NativeLayer::defs(const std::string& scope) const
+{
+  // The order of the layer is an order in which the backend can read it, so
+  // what comes out in one scope keeps it.
+  std::stringstream out;
+  for (const Def& d : d_defs)
+  {
+    std::map<std::string, std::string>::const_iterator u = d_at.find(d.d_name);
+    if (u != d_at.end() && u->second == scope)
+    {
+      out << d.d_text;
+    }
+  }
+  // A block carries the blank line that separates it from the next, which the
+  // last of them has no use for: the module writes its own.
+  std::string text = out.str();
+  text.erase(text.find_last_not_of('\n') + 1);
+  return text;
+}
+
+}  // namespace ethos
diff --git a/plugins/native_layer.h b/plugins/native_layer.h
new file mode 100644
index 00000000..39843745
--- /dev/null
+++ b/plugins/native_layer.h
@@ -0,0 +1,98 @@
+/******************************************************************************
+ * This file is part of the ethos project.
+ *
+ * Copyright (c) 2023-2024 by the authors listed in the file AUTHORS
+ * in the top-level source directory and their institutional affiliations.
+ * All rights reserved.  See the file COPYING in the top-level source
+ * directory for licensing information.
+ ******************************************************************************/
+#ifndef PLUGIN_NATIVE_LAYER_H
+#define PLUGIN_NATIVE_LAYER_H
+
+#include <map>
+#include <string>
+#include <vector>
+
+namespace ethos {
+
+/**
+ * The native layer of a backend: the definitions its generated text is
+ * allowed to call and no compiler writes, and the part of them a compilation
+ * of an input reaches.
+ *
+ * A layer is a configuration set -- plugins/lean_meta/lean.eos for the Lean
+ * backend, plugins/smt_meta/smt-vc.eos for the SMT-LIB one -- which
+ * tools/eoc/sem_compile.py compiles to the file read here. The line that
+ * opens a block says everything a stage has to know about it:
+ *
+ *   <comment> $native <name> <needs> <calls>...
+ *
+ * <name> is what the block defines and what a signature may reach, <needs>
+ * the narrowest scope it can come out in, and <calls> the rest of the layer
+ * its text names, which is what the closure is taken over. A block is
+ * everything under that line, its own comment included, up to the line that
+ * opens the next. One further line, `<comment> $native-keep <name>...`, names
+ * what is kept whatever an input reaches, which is what the resources of the
+ * stage name themselves. See render_native in sem_compile.py.
+ *
+ * What the stage adds is which of it an input reaches: a name of the layer
+ * reaches generated text only by being printed into it, so a stage notes each
+ * as it prints it, against the scope of the module the text comes out in.
+ * Nothing is read back out of what the stage wrote.
+ */
+class NativeLayer
+{
+ public:
+  /**
+   * Read the layer compiled to path.
+   *
+   * `comment` opens a comment in the language the layer is written in, e.g.
+   * `--` for Lean and `;` for SMT-LIB. `top` is the scope every module of the
+   * backend sees, which is where a block that two of them reach comes out and
+   * the only scope a backend that writes one module has.
+   */
+  NativeLayer(const std::string& path,
+              const std::string& comment,
+              const std::string& top);
+  /**
+   * Note that the module of scope `scope` names n, which is what asks for the
+   * block defining n and for everything that block calls. A name the layer
+   * does not define is one a module writes for itself and is nothing to
+   * place.
+   *
+   * Where a block comes out is the demand for it: a block two modules reach
+   * comes out in the scope they share, which is the top one, and a block that
+   * one scope alone can hold comes out there whatever reaches it.
+   */
+  void use(const std::string& n, const std::string& scope);
+  /** As above, from the scope every module sees. */
+  void use(const std::string& n);
+  /** The part of the layer that comes out in scope, in the layer's order. */
+  std::string defs(const std::string& scope) const;
+
+ private:
+  /** One block of the layer, as the line that opens it says it. */
+  struct Def
+  {
+    /** What it defines, and what a signature may reach. */
+    std::string d_name;
+    /** The narrowest scope it can come out in, i.e. the one its text names. */
+    std::string d_needs;
+    /** The rest of the layer it calls, which the closure is taken over. */
+    std::vector<std::string> d_deps;
+    /** The text it is, carried as it stands. */
+    std::string d_text;
+  };
+  /** The scope every module sees, see the constructor. */
+  std::string d_top;
+  /** The layer, in the order it gives its blocks. */
+  std::vector<Def> d_defs;
+  /** The block that defines each name. */
+  std::map<std::string, size_t> d_of;
+  /** The blocks the compilation reached, and the scope each comes out in. */
+  std::map<std::string, std::string> d_at;
+};
+
+}  // namespace ethos
+
+#endif
diff --git a/plugins/smt_meta/smt-vc.eos b/plugins/smt_meta/smt-vc.eos
new file mode 100644
index 00000000..525f6efd
--- /dev/null
+++ b/plugins/smt_meta/smt-vc.eos
@@ -0,0 +1,324 @@
+;; The native layer of the SMT-LIB backend: what the verification condition a
+;; run writes is written over and no compiler writes.
+;;
+;; One entry is one block of the layer. The name it declares is the name the
+;; embedding reaches it by, spelled the way a set spells it; whatever else its
+;; :smt-impl declares has no name here and so is private to it. A definition
+;; that is axiomatised rather than defined -- a declare-fun and the assert
+;; that says what it is -- is one block, since neither half is of any use
+;; without the other.
+;;
+;; Where in the file a block can come out is not said here: its SMT-LIB is
+;; what says that, by naming a datatype of the embedding or naming none, see
+;; vc_needs in tools/eoc/sem_compile.py. The blocks that name none of them
+;; come out where SMT-LIB alone is in scope, above the declaration of those
+;; datatypes, and the rest below it.
+;;
+;; A block is emitted only if the compilation of an input reaches it, which
+;; for this backend is what keeps a verification condition to the definitions
+;; and the axioms it is about. A definition no input reaches, because the
+;; resources of the stage are what name it, says :keep and is emitted
+;; whatever an input reaches.
+;;
+;; Compiled by tools/eoc/sem_compile.py; the stage that reads what it compiles
+;; to is the smt-meta stage of ethos-eoc. The Lean backend says the same thing
+;; in Lean, see plugins/lean_meta/lean.eos.
+
+(define-native-method Rat
+  :smt-impl "(define-sort Rat () Real)")
+
+(define-native-method iff
+  :smt-impl "(define-fun iff ((x Bool) (y Bool)) Bool (= x y))")
+
+(define-native-method mk_rational
+  :smt-impl "; Helpers to avoid mixed arithmetic
+(define-fun mk_rational ((x Int) (y Int)) Real (/ (to_real x) (to_real y)))")
+
+(define-native-method zeq
+  :smt-impl "(define-fun zeq ((x Int) (y Int)) Bool (= x y))")
+
+(define-native-method zleq
+  :smt-impl "(define-fun zleq ((x Int) (y Int)) Bool (<= x y))")
+
+(define-native-method zlt
+  :smt-impl "(define-fun zlt ((x Int) (y Int)) Bool (< x y))")
+
+(define-native-method zplus
+  :smt-impl "(define-fun zplus ((x Int) (y Int)) Int (+ x y))")
+
+(define-native-method zmult
+  :smt-impl "(define-fun zmult ((x Int) (y Int)) Int (* x y))")
+
+(define-native-method zneg
+  :smt-impl "(define-fun zneg ((x Int)) Int (- x))")
+
+(define-native-method zabs
+  :smt-impl "(define-fun zabs ((x Int)) Int (ite (< x 0) (- x) x))")
+
+(define-native-method qeq
+  :smt-impl "(define-fun qeq ((x Real) (y Real)) Bool (= x y))")
+
+(define-native-method qleq
+  :smt-impl "(define-fun qleq ((x Real) (y Real)) Bool (<= x y))")
+
+(define-native-method qlt
+  :smt-impl "(define-fun qlt ((x Real) (y Real)) Bool (< x y))")
+
+(define-native-method qplus
+  :smt-impl "(define-fun qplus ((x Real) (y Real)) Real (+ x y))")
+
+(define-native-method qmult
+  :smt-impl "(define-fun qmult ((x Real) (y Real)) Real (* x y))")
+
+(define-native-method qneg
+  :smt-impl "(define-fun qneg ((x Real)) Real (- x))")
+
+(define-native-method qabs
+  :smt-impl "(define-fun qabs ((x Real)) Real (ite (< x 0) (- x) x))")
+
+(define-native-method zdiv_total
+  :smt-impl "(define-fun zdiv_total ((x Int) (y Int)) Real (/_total (to_real x) (to_real y)))")
+
+(define-native-method qdiv_total
+  :smt-impl "(define-fun qdiv_total ((x Real) (y Real)) Real (/_total x y))")
+
+(define-native-method Char
+  :smt-impl "(define-sort Char () Int)")
+
+(define-native-method streq
+  :smt-impl "(define-fun streq ((x String) (y String)) Bool (= x y))")
+
+;; Whether the first string is a prefix of the second.
+(define-native-method string_prefix_eq
+  :smt-impl "(define-fun string_prefix_eq ((x String) (y String)) Bool
+  (str.prefixof x y))")
+
+(define-native-method re_ext_eq
+  :smt-impl "; can rely on first class equality for regular expressions
+(define-fun re_ext_eq ((r1 RegLan) (r2 RegLan)) Bool (= r1 r2))")
+
+(define-native-method Nat
+  :smt-impl "(declare-datatype Nat ((nat.zero) (nat.succ (nat.succ.arg1 Nat))))")
+
+(define-native-method nateq
+  :smt-impl "(define-fun nateq ((x Nat) (y Nat)) Bool (= x y))")
+
+(define-native-method int.to_nat
+  :smt-impl "(declare-fun int.to_nat (Int) Nat)
+(assert (! (forall ((x Int))
+  (! (= (int.to_nat x) (ite (<= x 0) nat.zero (nat.succ (int.to_nat (- x 1)))))
+  :pattern ((int.to_nat x))))
+  :named smtx.int.to_nat.def))")
+
+(define-native-method nat.to_int
+  :smt-impl "(declare-fun nat.to_int (Nat) Int)
+(assert (! (forall ((x Nat))
+  (! (= (nat.to_int x) (ite ((_ is nat.succ) x) (+ 1 (nat.to_int (nat.succ.arg1 x))) 0))
+  :pattern ((nat.to_int x))))
+  :named smtx.nat.to_int.def))")
+
+(define-native-method nat.+
+  :smt-impl "(declare-fun nat.+ (Nat Nat) Nat)
+(assert (! (forall ((x Nat) (y Nat))
+  (! (= (nat.+ x y) (ite ((_ is nat.succ) x) (nat.+ (nat.succ.arg1 x) (nat.succ y)) y))
+  :pattern ((nat.+ x y))))
+  :named smtx.nat.+.def))")
+
+(define-native-method /_by_zero_id
+  :smt-impl "; uninterpreted constant identifier for builtin partial functions
+(define-fun /_by_zero_id () String \"@/_by_zero\")")
+
+(define-native-method div_by_zero_id
+  :smt-impl "(define-fun div_by_zero_id () String \"@div_by_zero\")")
+
+(define-native-method mod_by_zero_id
+  :smt-impl "(define-fun mod_by_zero_id () String \"@mod_by_zero\")")
+
+(define-native-method wrong_apply_sel_id
+  :smt-impl "(define-fun wrong_apply_sel_id ((x Nat) (y Nat)) String
+  (str.++ \"@wrong_apply_sel_\" (str.from_int (nat.to_int x)) \"_\" (str.from_int (nat.to_int y))))")
+
+(define-native-method oob_seq_nth_id
+  :smt-impl "(define-fun oob_seq_nth_id () String \"@oob_seq_nth\")")
+
+(define-native-method uconst_id
+  :smt-impl "(define-fun uconst_id ((x Nat)) String (str.++ \"@u.\" (str.from_int (nat.to_int x))))")
+
+(define-native-method const_id
+  :smt-impl "(define-fun const_id ((x Nat)) String (str.++ \"@c.\" (str.from_int (nat.to_int x))))")
+
+(define-native-method char_valid
+  :smt-impl "(define-fun char_valid ((x Int)) Bool (and (<= 0 x) (< x 196608)))")
+
+(define-native-method string_valid
+  :smt-impl "(define-fun string_valid ((x String)) Bool true)")
+
+(define-native-method zexp_total
+  :smt-impl "; integer exponentiation is not handled by cvc5, axiomatize it
+(declare-fun zexp_total (Int Int) Int)
+(assert (! (forall ((x Int) (y Int))
+  (! (= (zexp_total x y) (ite (< y 0) 0 (ite (= y 0) 1 (* x (zexp_total x (- y 1))))))
+  :pattern ((zexp_total x y))))
+  :named smtx.zexp_total.def))")
+
+(define-native-method qexp_total
+  :smt-impl "(declare-fun qexp_total (Real Int) Real)
+(assert (! (forall ((x Real) (y Int))
+  (! (= (qexp_total x y) (ite (< y 0) 0.0 (ite (= y 0) 1.0 (* x (qexp_total x (- y 1))))))
+  :pattern ((qexp_total x y))))
+  :named smtx.qexp_total.def))")
+
+(define-native-method bit
+  :smt-impl "(define-fun bit ((x1 Int) (x2 Int)) Bool
+  (zeq 1 (mod (div x1 (int.pow2 x2)) 2)))")
+
+(define-native-method msb
+  :smt-impl "(define-fun msb ((x1 Int) (x2 Int)) Bool
+  (bit x2 (zplus x1 (zneg 1))))")
+
+(define-native-method binary_and
+  :smt-impl "(define-fun binary_and ((x1 Int) (x2 Int) (x3 Int)) Int
+  (ite (zeq x1 0) 0 (piand x1 x2 x3)))")
+
+(define-native-method binary_or
+  :smt-impl "(define-fun binary_or ((x1 Int) (x2 Int) (x3 Int)) Int
+  (zplus x2 (zplus x3 (zneg (ite (zeq x1 0) 0 (piand x1 x2 x3))))))")
+
+(define-native-method binary_xor
+  :smt-impl "(define-fun binary_xor ((x1 Int) (x2 Int) (x3 Int)) Int
+  (zplus x2 (zplus x3 (zneg (zmult 2 (ite (zeq x1 0) 0 (piand x1 x2 x3)))))))")
+
+(define-native-method binary_not
+  :smt-impl "(define-fun binary_not ((x1 Int) (x2 Int)) Int
+  (zplus (int.pow2 x1) (zneg (zplus x2 1))))")
+
+(define-native-method binary_max
+  :smt-impl "(define-fun binary_max ((x1 Int)) Int
+  (zplus (int.pow2 x1) (zneg 1)))")
+
+(define-native-method binary_uts
+  :smt-impl "(define-fun binary_uts ((w Int) (n Int)) Int
+  (zplus (zmult 2 (mod n (int.pow2 (zplus w (zneg 1))))) (zneg n)))")
+
+(define-native-method binary_concat
+  :smt-impl "(define-fun binary_concat ((x1 Int) (x2 Int) (x3 Int) (x4 Int)) Int
+  (zplus (zmult x2 (int.pow2 x3)) x4))")
+
+(define-native-method binary_extract
+  :smt-impl "(define-fun binary_extract ((x1 Int) (x2 Int) (x3 Int) (x4 Int)) Int
+  (div x2 (int.pow2 x4)))")
+
+(define-native-method reserved_datatype_name
+  :smt-impl "(define-fun reserved_datatype_name ((s String)) Bool (str.prefixof \"@\" s))")
+
+(define-native-method unpack_seq
+  :smt-impl "; sequences and string conversions
+(declare-fun unpack_seq (ssm.Seq) (Seq vsm.Value))
+(assert (! (forall ((x ssm.Seq))
+  (! (= (unpack_seq x)
+    (ite ((_ is ssm.cons) x)
+      (seq.++ (seq.unit (ssm.cons.arg1 x)) (unpack_seq (ssm.cons.arg2 x)))
+      (as seq.empty (Seq vsm.Value))))
+  :pattern ((unpack_seq x))))
+  :named smtx.unpack_seq.def))")
+
+(define-native-method pack_seq
+  :smt-impl "(declare-fun pack_seq (tsm.Type (Seq vsm.Value)) ssm.Seq)
+(assert (! (forall ((T tsm.Type) (x (Seq vsm.Value)))
+  (! (= (pack_seq T x)
+    (ite (> (seq.len x) 0)
+      (ssm.cons (seq.nth x 0) (pack_seq T (seq.extract x 1 (- (seq.len x) 1))))
+      (ssm.empty T)))
+  :pattern ((pack_seq T x))))
+  :named smtx.pack_seq.def))")
+
+(define-native-method char_of_value
+  :smt-impl "(declare-fun char_of_value (vsm.Value) String)
+(assert (! (forall ((x vsm.Value))
+  (! (= (char_of_value x)
+    (ite ((_ is vsm.Char) x) (str.from_code (vsm.Char.arg1 x)) \"\"))
+  :pattern ((char_of_value x))))
+  :named smtx.char_of_value.def))")
+
+(define-native-method unpack_string
+  :smt-impl "(declare-fun unpack_string (ssm.Seq) String)
+(assert (! (forall ((x ssm.Seq))
+  (! (= (unpack_string x)
+    (ite ((_ is ssm.cons) x)
+      (str.++ (char_of_value (ssm.cons.arg1 x)) (unpack_string (ssm.cons.arg2 x)))
+      \"\"))
+  :pattern ((unpack_string x))))
+  :named smtx.unpack_string.def))")
+
+(define-native-method pack_string
+  :smt-impl "(declare-fun pack_string (String) ssm.Seq)
+(assert (! (forall ((x String))
+  (! (= (pack_string x)
+    (ite (> (str.len x) 0)
+      (ssm.cons (vsm.Char (str.to_code (str.substr x 0 1))) (pack_string (str.substr x 1 (- (str.len x) 1))))
+      (ssm.empty tsm.Char)))
+  :pattern ((pack_string x))))
+  :named smtx.pack_string.def))")
+
+(define-native-method values_to_string
+  :smt-impl "; conversions between native strings and (unpacked) sequences of character
+; values, used by the value-sequence based regular expression operators below
+(declare-fun values_to_string ((Seq vsm.Value)) String)
+(assert (! (forall ((x (Seq vsm.Value)))
+  (! (= (values_to_string x)
+    (ite (> (seq.len x) 0)
+      (str.++ (char_of_value (seq.nth x 0)) (values_to_string (seq.extract x 1 (- (seq.len x) 1))))
+      \"\"))
+  :pattern ((values_to_string x))))
+  :named smtx.values_to_string.def))")
+
+(define-native-method string_to_values
+  :smt-impl "(declare-fun string_to_values (String) (Seq vsm.Value))
+(assert (! (forall ((x String))
+  (! (= (string_to_values x)
+    (ite (> (str.len x) 0)
+      (seq.++ (seq.unit (vsm.Char (str.to_code (str.substr x 0 1)))) (string_to_values (str.substr x 1 (- (str.len x) 1))))
+      (as seq.empty (Seq vsm.Value))))
+  :pattern ((string_to_values x))))
+  :named smtx.string_to_values.def))")
+
+(define-native-method str_to_re
+  :smt-impl "; the value-sequence based regular expression operators; these are the SMT2
+; counterparts of native string regular expression operators. Their arguments
+; are canonical character sequences, while generic sequence pattern operators
+; map directly to the polymorphic SMT seq.* operators.
+(define-fun str_to_re ((x (Seq vsm.Value))) RegLan
+  (str.to_re (values_to_string x)))")
+
+(define-native-method re_range
+  :smt-impl "(define-fun re_range ((x (Seq vsm.Value)) (y (Seq vsm.Value))) RegLan
