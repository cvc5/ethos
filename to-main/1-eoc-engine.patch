+  let bnds := 0 :: impl_native_re_scan_ends_aux (s.length + 1) r s 0
+  if 0 ≤ n ∧ Int.toNat n < bnds.length then
+    Int.ofNat (bnds.getD (Int.toNat n) 0)
+  else
+    -1")
