+++ b/tools/eoc/cpc/install_logos
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+# Generate the full CPC Lean package and install it into local Logos trees.
+# Usage: install_logos
+# Output: first compiles the model-smt signatures, saying what smt_defs.eo and
+# user_defs.eo were each compiled from; see eoc_compile_sem_signatures in
+# common.sh. It then generates the Lean under the name Cpc and copies the tree
+# it published in tools/eoc/out/lean/ into $LOGOS_DIR/Cpc, which is the layout
+# the package has. Existing rule files under Proofs/Rules there are preserved,
+# and every module that is not one is installed with the banner a generated
+# module of a Logos package carries; see eoc_banner_lean_outputs in common.sh.
+# It then optionally regenerates the Lean regressions under
+# $LOGOS_DIR/test/regress from $LOGOS_TESTS_DIR when that directory exists,
+# leaving nothing of its own behind there.
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+source "$SCRIPT_DIR/common.sh"
+
+BUILD_DIR="$(eoc_build_dir)"
+FINAL_OUT_DIR="$(eoc_final_out_dir)"
+LOGOS_DIR="${LOGOS_DIR:-$HOME/logos}"
+LOGOS_TESTS_DIR="${LOGOS_TESTS_DIR:-$EOC_REPO_ROOT/smtlibTests/logos-tests}"
+LOGOS_REGRESS_DIR="${LOGOS_REGRESS_DIR:-$LOGOS_DIR/test/regress}"
+CVC5_LOGOS="${CVC5_LOGOS:-$HOME/bin/cvc5-logos}"
+CPC_GEN_LOGOS_CMD="${CPC_GEN_LOGOS_CMD:-cpc_gen_logos.sh}"
+
+eoc_compile_sem_signatures
+
+EOC_LEAN_CALC=Cpc "$SCRIPT_DIR/run_gen_lean_all"
+
+eoc_copy_lean_outputs "$LOGOS_DIR/Cpc" "$FINAL_OUT_DIR" 1
+eoc_banner_lean_outputs "$LOGOS_DIR/Cpc"
+
+"$SCRIPT_DIR/install_logos_mini"
+
+if [[ -d "$LOGOS_TESTS_DIR" ]] \
+  && command -v "$CPC_GEN_LOGOS_CMD" >/dev/null 2>&1 \
+  && [[ -x "$CVC5_LOGOS" ]]; then
+  eoc_step "Generating the Logos regressions into $(eoc_rel "$LOGOS_REGRESS_DIR")"
+  (
+    cd "$LOGOS_TESTS_DIR"
+    shopt -s nullglob
+    # The generator writes what it read and what it wrote beside each input,
+    # as temp.txt and <input>.cpc.lean; what the run wanted is the copy under
+    # $LOGOS_DIR/test/regress, so the rest goes however this ends.
+    trap 'rm -f temp.lean temp.txt ./*.smt2.cpc.lean' EXIT
+    for file in *.smt2; do
+      base_file="$(basename "$file")"
+      base_name="${base_file%.*}"
+      eoc_item "$(printf '%-28s -> %s' "$base_file" "test-$base_name.cpc.lean")"
+      "$CPC_GEN_LOGOS_CMD" "$CVC5_LOGOS" "$file" > temp.lean
+      mkdir -p "$LOGOS_REGRESS_DIR"
+      cp temp.lean "$LOGOS_REGRESS_DIR/test-$base_name.cpc.lean"
+    done
+  )
+elif [[ -d "$LOGOS_TESTS_DIR" ]]; then
+  eoc_warning "skipping the Logos regressions: CPC_GEN_LOGOS_CMD or CVC5_LOGOS is unavailable"
+fi
+
+eoc_step "Cleaning the stage files"
+EOC_SKIP_CVC5="${EOC_SKIP_CVC5:-1}" "$SCRIPT_DIR/run_clean"
