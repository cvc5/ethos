@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Generate the reduced CPC Lean package used for CpcMini-style downstream tests.
+# Usage: install_logos_mini
+# Output: generates the Lean under the name $SUB_DIR, with no parser, and
+# copies the tree it published in tools/eoc/out/lean/ into $LOGOS_DIR/$SUB_DIR,
+# the same layout install_logos installs, banner and all. Any existing rule
+# files under Proofs/Rules are preserved.
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+source "$SCRIPT_DIR/common.sh"
+
+BUILD_DIR="$(eoc_build_dir)"
+FINAL_OUT_DIR="$(eoc_final_out_dir)"
+LOGOS_DIR="${LOGOS_DIR:-$HOME/logos}"
+SUB_DIR="${SUB_DIR:-CpcMini}"
+read -r -a MINI_TARGETS <<< "${MINI_TARGETS:-symm contra refl scope trans}"
+
+eoc_step "Generating the Mini-Lean signature"
+EOC_LEAN_CALC="$SUB_DIR" "$SCRIPT_DIR/run_gen_lean" --no-parser "${MINI_TARGETS[@]}"
+
+eoc_copy_lean_outputs "$LOGOS_DIR/$SUB_DIR" "$FINAL_OUT_DIR" 1
+eoc_banner_lean_outputs "$LOGOS_DIR/$SUB_DIR"
+
+if [[ -d "$LOGOS_DIR/$SUB_DIR" ]]; then
+  (
+    cd "$LOGOS_DIR/$SUB_DIR"
+    shopt -s nullglob
+    while IFS= read -r -d '' file; do
+      eoc_sed_in_place 's/partial def /def /g' "$file"
+    done < <(find . -type f -name '*.lean' -print0)
+  )
+fi
